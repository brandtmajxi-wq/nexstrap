<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Nexstrap</RootNamespace>
    <AssemblyName>Nexstrap</AssemblyName>
    <ApplicationIcon>Resources\Branding\Nexstrap.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Version information (single source of truth for the updater) -->
    <Version>1.19.0</Version>
    <AssemblyVersion>1.19.0.0</AssemblyVersion>
    <FileVersion>1.19.0.0</FileVersion>
    <Product>Nexstrap</Product>
    <Description>The Roblox launcher, reimagined.</Description>
    <Company>Nexstrap</Company>
    <Copyright>Copyright © 2026 Nexstrap contributors</Copyright>
  </PropertyGroup>

  <!-- Personal dev copy, built by tools/update-dev.ps1. Its own output folders keep it out of Release builds. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);DEV_BUILD</DefineConstants>
    <Optimize>true</Optimize>
    <Version>1.20.0</Version>
    <AssemblyVersion>1.20.0.0</AssemblyVersion>
    <FileVersion>1.20.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Branding\Nexstrap.ico" />
    <Resource Include="Resources\Welcome\*.jpg" Exclude="Resources\Welcome\winter-*.jpg" />
    <Resource Include="Resources\Welcome\winter-*.jpg" Condition="'$(Configuration)' == 'Dev'" />
    <EmbeddedResource Include="Resources\Languages\*.json" LogicalName="Nexstrap.Languages.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexstrap.Tests" />
    <!-- Windows Forms is only used for the tray icon; its names clash with WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
