<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Marker used by ThemeService to find and swap this dictionary -->
    <sys:String x:Key="Theme.Name">Dark</sys:String>

    <!-- Charcoal surfaces, from deepest to most raised -->
    <SolidColorBrush x:Key="Brush.Window" Color="#0E0F13" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#121318" />
    <SolidColorBrush x:Key="Brush.Card" Color="#17181E" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#1C1D24" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#22232B" />
    <SolidColorBrush x:Key="Brush.Input" Color="#101116" />

    <SolidColorBrush x:Key="Brush.Border" Color="#24252D" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#30313B" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#1D1E25" />

    <SolidColorBrush x:Key="Brush.Text" Color="#F2F3F7" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A4A7B4" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6C6F7D" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#18FFFFFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#1F3DD68C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5B841" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#1FF5B841" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F2555A" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#1FF2555A" />
</ResourceDictionary>
