<!--
    The new look, DEV Launcher only for now (merged last by App when AppInfo.IsDev, so these keys win).
    Text that sits straight on the background picture gets a soft shadow so it stays readable, and cards feel
    more alive: accent-coloured icons, a gentle lift and an accent edge on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Nexstrap.Controls">

    <DropShadowEffect x:Key="Revamp.TextShadow" Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.85" RenderingBias="Performance" />

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Effect" Value="{DynamicResource Revamp.TextShadow}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Effect" Value="{DynamicResource Revamp.TextShadow}" />
    </Style>

    <!-- Section headings: bigger, with an accent bar in front and a shadow behind -->
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
        <Setter Property="Margin" Value="2,20,0,10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Effect" Value="{DynamicResource Revamp.TextShadow}" />
        <Setter Property="Background">
            <Setter.Value>
                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                    <VisualBrush.Visual>
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setting cards: accent icon chip, lift and accent edge on hover -->
    <Style TargetType="ui:SettingCard">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingCard">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" Padding="18,14">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconHost" Width="36" Height="36" CornerRadius="{DynamicResource Radius.Control}" Margin="0,0,14,0"
                                    Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Icon}" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Text.Base}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource Text.Caption}"
                                           FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="{StaticResource Motion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Normal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar ===== -->

    <!-- Pages: the icon sits in its own chip, which fills with the accent on the open page; hovering nudges it right -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Brush.Hover}" Opacity="0" />
                        <Border x:Name="Sel" CornerRadius="{DynamicResource Radius.Control}" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="{DynamicResource Color.Accent}" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.OpacityMask>
                                <SolidColorBrush Color="#59000000" />
                            </Border.OpacityMask>
                        </Border>
                        <StackPanel x:Name="Row" Orientation="Horizontal" Margin="6,0" RenderTransformOrigin="0,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="Nudge" />
                            </StackPanel.RenderTransform>
                            <Border x:Name="Chip" Width="28" Height="28" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource Brush.Hover}">
                                <TextBlock x:Name="Icon" Text="{TemplateBinding ui:Ui.Icon}" FontFamily="{StaticResource Font.Icons}"
                                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource Sidebar.LabelVisibility}" />
                        </StackPanel>
                        <!-- Count from NavItem.Badge (the row's DataContext) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0"
                                Background="{DynamicResource Brush.Accent}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Nudge" Storyboard.TargetProperty="X" To="3" Duration="{StaticResource Motion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Nudge" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource Motion.Normal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Play card at the bottom of the sidebar: "Play Roblox", or a pulsing dot with the game and time while playing -->
    <Style x:Key="Sidebar.PlayCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Radius.Card}" Padding="10" RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="{DynamicResource Color.Accent}" />
                                <GradientStop Offset="1" Color="#33000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="34" Height="34">
                                <Ellipse Fill="#33FFFFFF" />
                                <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource Font.Icons}" FontSize="14" Margin="2,0,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                <Ellipse x:Name="Pulse" Width="12" Height="12" Fill="#4ADE80" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="PulseScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource Sidebar.LabelVisibility}">
                                <TextBlock x:Name="Title" Text="{DynamicResource L.Home.PlayRoblox}" FontFamily="{DynamicResource Font.Primary}"
                                           FontWeight="Bold" FontSize="13" Foreground="White" />
                                <TextBlock x:Name="Sub" Text="{DynamicResource L.Sidebar.Ready}" FontFamily="{DynamicResource Font.Primary}"
                                           FontSize="11" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pulse" Property="Opacity" Value="1" />
                            <Setter TargetName="Title" Property="Text" Value="{DynamicResource L.Sidebar.Playing}" />
                            <Setter TargetName="Sub" Property="Text" Value="{Binding NowPlaying}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Pulsing">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1.25" Duration="0:0:0.9" />
                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1.25" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulsing" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Home dashboard: one small stat -->
    <Style x:Key="Revamp.StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="5" />
    </Style>

    <!-- Home dashboard: a game tile with its picture and a play button that appears on hover -->
    <Style x:Key="Revamp.GameTile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="118" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="11,11,0,0" Background="{DynamicResource Brush.Hover}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" FontSize="28" Opacity="0.4" />
                                    <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="PlayBadge" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.Accent}" Opacity="0">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="PlayScale" ScaleX="0.8" ScaleY="0.8" CenterX="22" CenterY="22" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="18" Margin="3,0,0,0"
                                                   Foreground="{DynamicResource Brush.AccentForeground}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="12,9,12,11">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="{StaticResource Motion.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Normal}" />
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Normal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Normal}" />
                                        <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="{StaticResource Motion.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="{StaticResource Motion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
