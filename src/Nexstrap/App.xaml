<Application x:Class="Nexstrap.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the swappable theme (see ThemeService) -->
                <ResourceDictionary Source="Resources/Themes/Dark.xaml" />
                <ResourceDictionary Source="Resources/Themes/Branding.xaml" />
                <ResourceDictionary Source="Resources/Styles/Base.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Inputs.xaml" />
                <ResourceDictionary Source="Resources/Styles/Components.xaml" />
                <ResourceDictionary Source="Views/PageTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent defaults; ThemeService overwrites these at startup -->
            <Color x:Key="Color.Accent">#7C6CFF</Color>
            <SolidColorBrush x:Key="Brush.Accent" Color="#7C6CFF" />
            <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2E7C6CFF" />
            <SolidColorBrush x:Key="Brush.AccentForeground" Color="#FFFFFF" />
            <!-- Custom background (ImageBrush) written by ThemeService -->
            <SolidColorBrush x:Key="Brush.BackgroundImage" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
