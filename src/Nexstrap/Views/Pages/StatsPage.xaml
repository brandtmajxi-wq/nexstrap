<UserControl x:Class="Nexstrap.Views.Pages.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StatsViewModel}">
    <UserControl.Resources>
        <!-- A chart bar. In the new look (DEV only for now) the highlighted bar (today, busiest hour or day) stays bright and the rest fade back. -->
        <Style x:Key="StatsBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentFill}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.UseNewLook, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                        <Condition Binding="{Binding Highlight}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.45" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Round icon in front of a number, new look only -->
        <Style x:Key="StatsIcon" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Visibility" Value="{Binding UseNewLook, Converter={StaticResource BoolToVisibility}}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{DynamicResource L.Stats.Empty}" Style="{StaticResource Text.Secondary}" Margin="2,0,0,12" TextWrapping="Wrap"
                   Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}" />

        <UniformGrid Columns="4" Margin="-4,0">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="4">
                <DockPanel>
                    <Border Style="{StaticResource StatsIcon}">
                        <TextBlock Text="&#xE916;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Stats.Total}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TotalTime}" Style="{StaticResource Text.Title}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="4">
                <DockPanel>
                    <Border Style="{StaticResource StatsIcon}">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Stats.Sessions}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TotalSessions}" Style="{StaticResource Text.Title}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="4">
                <DockPanel>
                    <Border Style="{StaticResource StatsIcon}">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Stats.Streak}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentStreak}" Style="{StaticResource Text.Title}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="4">
                <DockPanel>
                    <Border Style="{StaticResource StatsIcon}">
                        <TextBlock Text="&#xE734;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Stats.BestStreak}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BestStreak}" Style="{StaticResource Text.Title}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- Highlights (new look, DEV only for now) -->
        <UniformGrid Columns="3" Margin="-4,0" Visibility="{Binding UseNewLook, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="4">
                <DockPanel>
                    <Border Style="{StaticResource StatsIcon}">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Stats.AverageSession}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding AverageSession}" Style="{StaticResource Text.Section}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="4">
                <DockPanel>
                    <Border Style="{StaticResource StatsIcon}">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Stats.LongestSession}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding LongestSession}" Style="{StaticResource Text.Section}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="4">
                <DockPanel>
                    <Border Style="{StaticResource StatsIcon}">
                        <TextBlock Text="&#xE909;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Stats.DifferentGames}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding DifferentGames}" Style="{StaticResource Text.Section}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="{DynamicResource L.Stats.Last14}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,16">
            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,0" ToolTip="{Binding Tip}">
                            <Grid Height="120">
                                <Border Height="{Binding Height}" CornerRadius="3" Style="{StaticResource StatsBar}" />
                            </Grid>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="{DynamicResource L.Stats.TopGames}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,12">
            <ItemsControl ItemsSource="{Binding TopGames}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource Text.Secondary}" Margin="12,0,0,0" />
                                <Border x:Name="Medal" DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Hover}" Margin="0,0,10,0"
                                        Visibility="{Binding DataContext.UseNewLook, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock x:Name="Rank" Text="{Binding Medal}" FontSize="12" FontWeight="Bold" FontFamily="{DynamicResource Font.Primary}" Foreground="{DynamicResource Brush.TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Share, Mode=OneWay}" Focusable="False" />
                        </StackPanel>
                    <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Rank}" Value="1"><Setter TargetName="Medal" Property="Background" Value="#F5C542" /><Setter TargetName="Rank" Property="Foreground" Value="#3A2A00" /></DataTrigger>
                            <DataTrigger Binding="{Binding Rank}" Value="2"><Setter TargetName="Medal" Property="Background" Value="#C9D1DB" /><Setter TargetName="Rank" Property="Foreground" Value="#26303A" /></DataTrigger>
                            <DataTrigger Binding="{Binding Rank}" Value="3"><Setter TargetName="Medal" Property="Background" Value="#D08A4E" /><Setter TargetName="Rank" Property="Foreground" Value="#3A1E05" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- When you play: by hour of the day and by weekday -->
        <TextBlock Text="{DynamicResource L.Stats.WhenYouPlay}" Style="{StaticResource SectionHeader}" />
        <Grid Margin="-4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="4">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Stats.ByHour}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding HourBars}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="1.5,0" ToolTip="{Binding Tip}" Background="Transparent">
                                    <Grid Height="80">
                                        <Border Height="{Binding Height}" CornerRadius="2" Style="{StaticResource StatsBar}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" Margin="4">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Stats.ByDay}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding DayBars}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,0" ToolTip="{Binding Tip}" Background="Transparent">
                                    <Grid Height="80">
                                        <Border Height="{Binding Height}" CornerRadius="3" Style="{StaticResource StatsBar}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding Busiest}" Margin="2,4,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Busiest}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding UseNewLook}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- New look: the busiest time as a pill -->
        <Border Margin="0,6,0,0" Padding="12,6" Background="{DynamicResource Brush.AccentSoft}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                    <Setter Property="Visibility" Value="{Binding UseNewLook, Converter={StaticResource BoolToVisibility}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Busiest}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Busiest}" Style="{StaticResource Text.Base}" FontSize="12.5" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Achievements: local milestones worked out from the play history -->
        <DockPanel Margin="0,0,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding AchievementSummary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Bottom" Margin="12,0,2,10" />
            <TextBlock Text="{DynamicResource L.Stats.Achievements}" Style="{StaticResource SectionHeader}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding AchievementList}" Focusable="False" Margin="-4,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Badge" Style="{StaticResource Card}" Padding="14,12" Margin="4">
                        <DockPanel>
                            <Border x:Name="IconBack" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Brush.Raised}" VerticalAlignment="Top" Margin="0,0,12,0">
                                <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="Name" Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowsProgress, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Focusable="False" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Unlocked}" Value="True">
                            <Setter TargetName="IconBack" Property="Background" Value="{DynamicResource Brush.AccentFill}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Unlocked}" Value="False">
                            <Setter TargetName="Name" Property="Opacity" Value="0.75" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{DynamicResource L.Stats.AchievementsNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0" />
    </StackPanel>
</UserControl>
