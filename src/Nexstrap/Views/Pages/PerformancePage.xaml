<UserControl x:Class="Nexstrap.Views.Pages.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PerformanceViewModel}">
    <StackPanel>

        <!-- ===== Status ===== -->
        <TextBlock Text="{DynamicResource L.Performance.FPSStatus}" Style="{StaticResource SectionHeader}" Margin="2,0,0,10" />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource Text.Base}" FontWeight="Medium" />
                <ItemsControl ItemsSource="{Binding Status}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Good">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Secondary}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Margin="0,8,0,0"
                           Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ===== Presets ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.Presets}" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="{DynamicResource L.Performance.SetsRobloxsFrameRateCapAnd}"
                   Style="{StaticResource Text.Caption}" Margin="2,-4,0,10" />
        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource TileButton}" Margin="0,0,8,8" Padding="14,12"
                            AutomationProperties.Name="{Binding Name, StringFormat='Preset {0}'}"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Cap ===== -->
        <TextBlock Text="{DynamicResource L.Performance.FrameRate}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xEC4A;" Header="{DynamicResource L.Performance.MaximumFrameRate}"
                        Description="{DynamicResource L.Performance.RobloxsOwnInGameCapIts}">
            <ComboBox Width="170" ItemsSource="{Binding CapChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Cap}" AutomationProperties.Name="Performance frame rate cap" />
        </ui:SettingCard>

        <!-- ===== Graphics preferences ===== -->
        <TextBlock Text="{DynamicResource L.Performance.GraphicsPreferences}" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="{DynamicResource L.Performance.TheseUseFastFlagsOnRobloxsAllowlist}"
                   Style="{StaticResource Text.Caption}" Margin="2,-4,0,10" />
        <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,8" Background="{DynamicResource Brush.WarningSoft}"
                Visibility="{Binding PlayUsesNexstrapBuild, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource L.FastFlags.GoToHome}" Padding="10,4" Margin="12,0,0,0" Command="{Binding GoHomeCommand}" />
                <TextBlock Text="{DynamicResource L.Performance.PlayIsntUsingANexstrapInstalled}" Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ui:SettingCard Icon="&#xE7F4;" Header="{DynamicResource L.Performance.GraphicsAPI}" Description="{DynamicResource L.Performance.WhichRendererRobloxPrefersIfOne}">
            <ComboBox Width="170" ItemsSource="{Binding ApiChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Api}" AutomationProperties.Name="{DynamicResource L.Performance.GraphicsAPI}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE7B3;" Header="{DynamicResource L.Performance.AntiAliasing}" Description="{DynamicResource L.Performance.SmoothsJaggedEdgesHigherValuesCost}">
            <ComboBox Width="170" ItemsSource="{Binding MsaaChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Msaa}" AutomationProperties.Name="{DynamicResource L.Performance.AntiAliasing}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xEB9F;" Header="{DynamicResource L.Performance.TextureQuality}" Description="{DynamicResource L.Performance.LowerLevelsUseLessVideoMemory}">
            <ComboBox Width="170" ItemsSource="{Binding TextureChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Textures}" AutomationProperties.Name="{DynamicResource L.Performance.TextureQuality}" />
        </ui:SettingCard>
    </StackPanel>
</UserControl>
