<UserControl x:Class="Nexstrap.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HomeViewModel}">
    <StackPanel>

        <!-- ===== Hero ===== -->
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Border CornerRadius="12" Opacity="0.9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="{DynamicResource Color.Accent}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.35" Color="Transparent" />
                            <GradientStop Offset="1" Color="#40000000" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <ContentPresenter Width="190" Height="190" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,34,0" Opacity="0.16" ContentTemplate="{StaticResource Template.LogoMark}" Content="{Binding}" />

                <StackPanel Margin="30,28,30,28">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                            <TextBlock Margin="7,0,0,0" FontSize="11.5" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Primary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource L.Home.ReadyToPlay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource L.Home.RobloxUpdateAvailable}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                <Setter Property="Text" Value="{DynamicResource L.Home.RobloxNotInstalled}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource L.Home.CheckingInstallation}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource L.Home.InstallingRoblox}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{DynamicResource L.Home.JumpBackIntoRoblox}" Style="{StaticResource Text.Display}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" MaxWidth="460" HorizontalAlignment="Left"
                               Text="{DynamicResource L.Home.NexstrapStartsTheOfficialRobloxClient}" />

                    <!-- Actions (hidden while installing) -->
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0"
                                Visibility="{Binding IsInstalling, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button Style="{StaticResource Button.Play}" ui:Ui.Icon="&#xE768;" Content="{DynamicResource L.Home.PlayRoblox}" MinWidth="180"
                                Command="{Binding PlayCommand}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                        <Button ui:Ui.Icon="&#xE896;" Content="{Binding InstallButtonText}" Margin="10,0,0,0" Padding="18,12"
                                Command="{Binding InstallCommand}"
                                Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding LaunchMessage}" Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center" Margin="18,0,0,0" />
                    </StackPanel>

                    <!-- Install progress -->
                    <StackPanel Margin="0,22,0,0" MaxWidth="520" HorizontalAlignment="Left" Width="520"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Common.Cancel}" Padding="10,4"
                                    Command="{Binding CancelInstallCommand}" />
                            <TextBlock Text="{Binding InstallStage}" Style="{StaticResource Text.Base}" FontWeight="Medium" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar Margin="0,10,0,0" Maximum="1" Value="{Binding InstallFraction, Mode=OneWay}" />
                        <TextBlock Text="{Binding InstallDetail}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Status tiles ===== -->
        <UniformGrid Columns="3" Margin="-5,12,-5,0">
            <Border Style="{StaticResource Card}" Margin="5" Padding="18,16">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Padding="10,6" Margin="0,0,6,4" ui:Ui.Icon="&#xE72C;" Content="{DynamicResource L.Home.Refresh}"
                                Command="{Binding RefreshCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Padding="10,6" Margin="0,0,0,4" ui:Ui.Icon="&#xE838;" Content="{DynamicResource L.Home.OpenFolder}"
                                Command="{Binding OpenInstallFolderCommand}" />
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Home.INSTALLATION}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource Text.Section}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding StatusDetail}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="5" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Home.ROBLOXVERSION}" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Section}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Installation.VersionHash, FallbackValue=''}" Style="{StaticResource Text.Caption}"
                               FontFamily="{StaticResource Font.Mono}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LatestText}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="5" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Home.WEBSITELINKS}" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="{Binding ProtocolOwner}" Style="{StaticResource Text.Section}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Text="{DynamicResource L.Home.TheAppWindowsOpensWhenYou}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== Join an experience ===== -->
        <TextBlock Text="{DynamicResource L.Home.JoinAnExperience}" Style="{StaticResource SectionHeader}" Margin="2,12,0,10" />
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Home.Join}" ui:Ui.Icon="&#xE768;"
                            Margin="10,0,0,0" MinWidth="96" Command="{Binding JoinCommand}" />
                    <TextBox ui:Ui.Icon="&#xE71B;" ui:Ui.Placeholder="{DynamicResource L.Games.PlaceIDOrRobloxComGames}"
                             AutomationProperties.Name="Experience"
                             Text="{Binding ExperienceInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding JoinCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock Text="{Binding ExperienceInputError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                           Margin="2,8,0,0" Visibility="{Binding ExperienceInputError, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding ExperienceStatus}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0"
                           Visibility="{Binding ExperienceStatus, Converter={StaticResource NullToVisibility}}" />

                <!-- Looked-up experience -->
                <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource Brush.Hover}"
                        Visibility="{Binding Experience, Converter={StaticResource NullToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                   Text="{Binding Experience.Playing, Converter={StaticResource LocFormat}, ConverterParameter=Format.Playing}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Experience.Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                       Text="{Binding Experience.CreatorName, Converter={StaticResource LocFormat}, ConverterParameter=Format.By}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Rejoin -->
                <DockPanel Margin="0,14,0,0" Visibility="{Binding CanRejoin, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource L.Home.Rejoin}" ui:Ui.Icon="&#xE72C;" Padding="12,5" Margin="12,0,0,0"
                            VerticalAlignment="Center" Command="{Binding RejoinCommand}" />
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Home.RejoinLastServer}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding RejoinName}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{DynamicResource L.Home.RejoinHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Recent -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="{DynamicResource L.Home.Clear}" FontSize="12"
                                Command="{Binding ClearRecentCommand}" />
                        <TextBlock Text="{DynamicResource L.Home.RECENT}" Style="{StaticResource Text.Overline}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RecentExperiences}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" ui:Ui.Icon="&#xE768;" Padding="10,5" Margin="0,0,8,8"
                                        ToolTip="{Binding PlaceId, Converter={StaticResource LocFormat}, ConverterParameter=Launch.Place}"
                                        Command="{Binding DataContext.JoinRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Installations ===== -->
        <TextBlock Text="{DynamicResource L.Home.Installations}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding IsAutomaticSelection}"
                              AutomationProperties.Name="{DynamicResource L.Home.ChooseAutomatically}" />
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Home.ChooseAutomatically}" Style="{StaticResource Text.Base}" FontWeight="Medium" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   Text="{DynamicResource L.Home.PlayUsesTheBuildThatMatches}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{DynamicResource L.Home.NoRobloxBuildsFoundOnThis}" Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                           Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Installations}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsUsedForPlay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{DynamicResource L.Home.UsedForPlay}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Text.Base}"
                                                       Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                        <Button Content="{DynamicResource L.Home.UseForPlay}" Padding="10,5"
                                                Visibility="{Binding IsUsedForPlay, Converter={StaticResource InverseBoolToVisibility}}"
                                                Command="{Binding DataContext.UseForPlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE838;" FontFamily="{StaticResource Font.Icons}" Margin="6,0,0,0"
                                                ToolTip="{DynamicResource L.Home.OpenFolder}" AutomationProperties.Name="{DynamicResource L.Home.OpenFolder}"
                                                Command="{Binding DataContext.OpenFolderOfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}"
                                                ToolTip="{DynamicResource L.Home.RemoveNexstrapBuildsOnly}" AutomationProperties.Name="{DynamicResource L.Appearance.Remove}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RemoveInstallationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Base}" FontWeight="Medium">
                                            <Run Text="{Binding Installation.DisplayVersion, Mode=OneWay}" />
                                            <Run Text="·" Foreground="{DynamicResource Brush.TextMuted}" />
                                            <Run Text="{Binding Installation.SourceLabel, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Installation.Directory}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{DynamicResource L.Home.OutdatedRobloxHasReleasedANewer}"
                                                   Foreground="{DynamicResource Brush.Warning}" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLatest}" Value="False" />
                                                                <Condition Binding="{Binding DataContext.LatestKnown, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Text.Caption}"
                           Text="{DynamicResource L.Home.BuildsInstalledByOtherLaunchersAre}" />

                <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}"
                        Visibility="{Binding CanAddNexstrapCopy, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Home.InstallANexstrapCopy}" ui:Ui.Icon="&#xE896;"
                                Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding InstallCommand}" />
                        <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                                   Text="{DynamicResource L.Home.FastFlagsOnlyApplyToRobloxBuilds}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Roblox Studio ===== -->
        <TextBlock Text="{DynamicResource L.Studio.Title}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,14" DataContext="{Binding Studio}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE838;" FontFamily="{StaticResource Font.Icons}" Margin="0,0,6,0"
                                ToolTip="{DynamicResource L.Home.OpenFolder}" AutomationProperties.Name="{DynamicResource L.Home.OpenFolder}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" Command="{Binding OpenFolderCommand}" />
                        <Button Content="{Binding InstallText}" Padding="12,6" Margin="0,0,8,0" Command="{Binding InstallCommand}"
                                Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Studio.Open}" Padding="14,6"
                                Command="{Binding OpenCommand}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Base}" FontWeight="Medium" />
                        <TextBlock Text="{Binding DetailText}" Margin="0,3,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Common.Cancel}" Padding="10,4"
                                Command="{Binding CancelInstallCommand}" />
                        <TextBlock Text="{Binding InstallStage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Margin="0,8,0,0" Maximum="1" Value="{Binding InstallFraction, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ===== Quick settings + updates ===== -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{DynamicResource L.Home.QuickSettings}" Style="{StaticResource SectionHeader}" />
                <ui:SettingCard Icon="&#xE793;" Header="{DynamicResource L.Home.LightTheme}" Description="{DynamicResource L.Home.SwitchBetweenTheDarkAndLight}">
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsLightTheme}" AutomationProperties.Name="Light theme toggle" />
                </ui:SettingCard>
                <ui:SettingCard Icon="&#xE8BB;" Header="{DynamicResource L.Home.CloseNexstrapAfterLaunch}" Description="{DynamicResource L.Home.ExitTheLauncherOnceRobloxHas}">
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseAfterLaunch}" AutomationProperties.Name="Close after launch" />
                </ui:SettingCard>
                <ui:SettingCard Icon="&#xE895;" Header="{DynamicResource L.Home.CheckForUpdatesOnLaunch}" Description="{DynamicResource L.Home.QuicklyAskGitHubForANewer}">
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CheckForUpdatesOnStartup}" AutomationProperties.Name="Check for updates on startup" />
                </ui:SettingCard>
            </StackPanel>

            <StackPanel x:Name="UpdatesCard" Grid.Column="2">
                <TextBlock Text="{DynamicResource L.Home.NexstrapUpdates}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.SuccessSoft}"
                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{DynamicResource L.Home.UpdateAvailable}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Text.Base}"
                                           Foreground="{DynamicResource Brush.Success}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.Home.INSTALLED}" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource Text.Section}" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0" />

                        <!-- What's new (from the GitHub release) -->
                        <TextBox Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Release notes"
                                 Text="{Binding ReleaseNotes, Mode=OneWay}"
                                 Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Download progress -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Common.Cancel}" Padding="8,3"
                                        Command="{Binding CancelUpdateCommand}" />
                                <TextBlock Text="{Binding UpdateStage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ProgressBar Margin="0,6,0,0" Maximum="1" Value="{Binding UpdateFraction, Mode=OneWay}" />
                        </StackPanel>

                        <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE896;" Content="{DynamicResource L.Home.DownloadInstall}" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Padding="12,6" Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />

                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Secondary}" Padding="10,6" Margin="0,0,6,4" ui:Ui.Icon="&#xE895;" Content="{DynamicResource L.Home.CheckNow}"
                                    Command="{Binding CheckForUpdatesCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Padding="10,6" Margin="0,0,0,4" ui:Ui.Icon="&#xE8A7;" Content="{DynamicResource L.Home.ReleasePage}"
                                    Command="{Binding OpenReleaseCommand}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                   Text="{DynamicResource L.Home.UpdatesComeOnlyFromThisProjects}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
