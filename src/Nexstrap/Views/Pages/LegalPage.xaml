<UserControl x:Class="Nexstrap.Views.Pages.LegalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LegalViewModel}">
    <UserControl.Resources>
        <Style x:Key="Legal.Head" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Legal.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,3,0,14" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Button Content="{DynamicResource L.Legal.Back}" ui:Ui.Icon="&#xE72B;" Padding="10,5" HorizontalAlignment="Left" Command="{Binding BackCommand}" />

        <TextBlock Text="{DynamicResource L.Legal.Privacy}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="22,18,22,6">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Short}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Short.Text}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Local}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Local.Text}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Login}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Login.Text}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Online}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Online.Roblox}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Online.GitHub}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Online.Discord}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Online.Catbox}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Online.Note}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Control}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Privacy.Control.Text}" Style="{StaticResource Legal.Body}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource L.Legal.Terms}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="22,18,22,6">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Legal.Terms.Unofficial}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Unofficial.Text}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Roblox}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Roblox.Text}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Uploads}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Uploads.Text}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Warranty}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Warranty.Text}" Style="{StaticResource Legal.Body}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Changes}" Style="{StaticResource Legal.Head}" />
                <TextBlock Text="{DynamicResource L.Legal.Terms.Changes.Text}" Style="{StaticResource Legal.Body}" />
            </StackPanel>
        </Border>

        <WrapPanel Margin="0,12,0,0">
            <Button Content="{DynamicResource L.Legal.Contact}" ui:Ui.Icon="&#xE8A7;" Padding="10,6" Margin="0,0,8,6" Command="{Binding OpenIssuesCommand}" />
            <Button Content="{DynamicResource L.Legal.Licence}" ui:Ui.Icon="&#xE8A7;" Padding="10,6" Margin="0,0,0,6" Command="{Binding OpenLicenseCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
