<UserControl x:Class="Nexstrap.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AboutViewModel}">
    <StackPanel>
        <!-- Identity -->
        <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Width="64" Height="64" ContentTemplate="{StaticResource Template.LogoMark}" Content="{Binding}" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE7F8;" Header="Runtime" Description="{Binding Runtime}">
            <Button Content="Copy diagnostics" ui:Ui.Icon="&#xE8C8;" Padding="10,6" Command="{Binding CopyDiagnosticsCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8B7;" Header="Data folder" Description="{Binding DataFolder}">
            <Button Content="Open" ui:Ui.Icon="&#xE838;" Padding="10,6" Command="{Binding OpenDataFolderCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE9F9;" Header="Logs" Description="One log file per session; the newest ten are kept.">
            <Button Content="Open" ui:Ui.Icon="&#xE838;" Padding="10,6" Command="{Binding OpenLogsFolderCommand}" />
        </ui:SettingCard>

        <TextBlock Text="Open-source components" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Components}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:SettingCard Header="{Binding Name}" Description="{Binding License, StringFormat='{}{0} licence'}">
                        <Button Style="{StaticResource Button.Ghost}" Content="Source" ui:Ui.Icon="&#xE8A7;" Padding="10,6"
                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Url}" />
                    </ui:SettingCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,18,0,0"
                   Text="Nexstrap is an independent project and is not affiliated with, endorsed by or sponsored by Roblox Corporation. Roblox is a trademark of Roblox Corporation." />
    </StackPanel>
</UserControl>
