<UserControl x:Class="Nexstrap.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AboutViewModel}">
    <StackPanel>
        <!-- Identity -->
        <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Width="64" Height="64" ContentTemplate="{StaticResource Template.LogoMark}" Content="{Binding}" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource L.About.Diagnostics}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE7F8;" Header="{DynamicResource L.About.Runtime}" Description="{Binding Runtime}">
            <Button Content="{DynamicResource L.About.CopyDiagnostics}" ui:Ui.Icon="&#xE8C8;" Padding="10,6" Command="{Binding CopyDiagnosticsCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8B7;" Header="{DynamicResource L.About.DataFolder}" Description="{Binding DataFolder}">
            <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE838;" Padding="10,6" Command="{Binding OpenDataFolderCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE9F9;" Header="{DynamicResource L.About.Logs}" Description="{DynamicResource L.About.OneLogFilePerSessionThe}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource L.About.ViewLogs}" ui:Ui.Icon="&#xE9F9;" Padding="10,6" Margin="0,0,8,0" Command="{Binding ViewLogsCommand}" />
                <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE838;" Padding="10,6" Command="{Binding OpenLogsFolderCommand}" />
            </StackPanel>
        </ui:SettingCard>

        <ui:SettingCard Icon="&#xE7BE;" Header="{DynamicResource L.About.Tour}" Description="{DynamicResource L.About.Tour.Text}">
            <Button Content="{DynamicResource L.About.Tour.Start}" ui:Ui.Icon="&#xE768;" Padding="10,6" Command="{Binding TourCommand}" />
        </ui:SettingCard>

        <TextBlock Text="{DynamicResource L.About.Shortcuts}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,10">
            <ItemsControl ItemsSource="{Binding ShortcutList}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,5">
                            <Border DockPanel.Dock="Left" MinWidth="150" Margin="0,0,16,0" HorizontalAlignment="Left">
                                <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Raised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                        CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding Keys}" Style="{StaticResource Text.Base}" FontFamily="Consolas" FontSize="12.5" />
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Text="{DynamicResource L.Shortcut.Note}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0" />

        <TextBlock Text="{DynamicResource L.About.Legal}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE72E;" Header="{DynamicResource L.About.Legal.Item}" Description="{DynamicResource L.About.Legal.Text}">
            <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE8A7;" Padding="10,6" Command="{Binding OpenLegalCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE72E;" Header="{DynamicResource L.Secret.Title}" Description="{DynamicResource L.Secret.Subtitle}">
            <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE72E;" Padding="10,6" Command="{Binding OpenSecretCommand}" />
        </ui:SettingCard>

        <TextBlock Text="{DynamicResource L.About.OpenSourceComponents}" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Components}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:SettingCard Header="{Binding Name}" Description="{Binding License, Converter={StaticResource LocFormat}, ConverterParameter=Format.Licence}">
                        <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.About.Source}" ui:Ui.Icon="&#xE8A7;" Padding="10,6"
                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Url}" />
                    </ui:SettingCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,18,0,0"
                   Text="{DynamicResource L.About.NexstrapIsAnIndependentProjectAnd}" />
    </StackPanel>
</UserControl>
