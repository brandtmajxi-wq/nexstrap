<UserControl x:Class="Nexstrap.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AboutViewModel}">
    <StackPanel>
        <!-- Identity -->
        <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Width="64" Height="64" ContentTemplate="{StaticResource Template.LogoMark}" Content="{Binding}" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource L.About.Diagnostics}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE7F8;" Header="{DynamicResource L.About.Runtime}" Description="{Binding Runtime}">
            <Button Content="{DynamicResource L.About.CopyDiagnostics}" ui:Ui.Icon="&#xE8C8;" Padding="10,6" Command="{Binding CopyDiagnosticsCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8B7;" Header="{DynamicResource L.About.DataFolder}" Description="{Binding DataFolder}">
            <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE838;" Padding="10,6" Command="{Binding OpenDataFolderCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE9F9;" Header="{DynamicResource L.About.Logs}" Description="{DynamicResource L.About.OneLogFilePerSessionThe}">
            <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE838;" Padding="10,6" Command="{Binding OpenLogsFolderCommand}" />
        </ui:SettingCard>

        <TextBlock Text="{DynamicResource L.About.OpenSourceComponents}" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Components}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:SettingCard Header="{Binding Name}" Description="{Binding License, Converter={StaticResource LocFormat}, ConverterParameter=Format.Licence}">
                        <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.About.Source}" ui:Ui.Icon="&#xE8A7;" Padding="10,6"
                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Url}" />
                    </ui:SettingCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,18,0,0"
                   Text="{DynamicResource L.About.NexstrapIsAnIndependentProjectAnd}" />
    </StackPanel>
</UserControl>
