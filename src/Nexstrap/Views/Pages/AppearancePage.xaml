<UserControl x:Class="Nexstrap.Views.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AppearanceViewModel}">
    <StackPanel>

        <!-- ===== Theme ===== -->
        <TextBlock Text="Theme" Style="{StaticResource SectionHeader}" Margin="2,0,0,10" />
        <UniformGrid Columns="2" Margin="-5,0">
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Theme" IsChecked="{Binding IsDark}" Margin="5"
                         AutomationProperties.Name="Dark theme">
                <StackPanel>
                    <Border Height="74" CornerRadius="8" Background="#0E0F13" BorderBrush="#24252D" BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="#121318" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Height="22" CornerRadius="4" Background="#1C1D24" />
                                <Border Height="10" Width="54" CornerRadius="3" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Dark" Style="{StaticResource Text.Base}" FontWeight="Medium" Margin="2,10,0,0" />
                    <TextBlock Text="Charcoal surfaces, easy on the eyes." Style="{StaticResource Text.Caption}" Margin="2,2,0,0" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Theme" IsChecked="{Binding IsLight}" Margin="5"
                         AutomationProperties.Name="Light theme">
                <StackPanel>
                    <Border Height="74" CornerRadius="8" Background="#F4F5F8" BorderBrush="#E1E3EA" BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="#ECEDF2" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Height="22" CornerRadius="4" Background="#FFFFFF" />
                                <Border Height="10" Width="54" CornerRadius="3" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Light" Style="{StaticResource Text.Base}" FontWeight="Medium" Margin="2,10,0,0" />
                    <TextBlock Text="Bright and crisp for daytime." Style="{StaticResource Text.Caption}" Margin="2,2,0,0" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- ===== Presets ===== -->
        <TextBlock Text="Presets" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="A preset changes the theme and accent colour. Your font and background stay as they are."
                   Style="{StaticResource Text.Caption}" Margin="2,-4,0,10" />
        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource TileButton}" Width="132" Margin="0,0,10,10" Padding="8"
                            AutomationProperties.Name="{Binding Name, StringFormat='Preset {0}'}"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <Border Height="44" CornerRadius="6"
                                    Background="{Binding Appearance.Theme, Converter={StaticResource ThemePreviewBrush}}">
                                <Grid Margin="7">
                                    <Border CornerRadius="3" Width="46" HorizontalAlignment="Left"
                                            Background="{Binding Appearance.Theme, Converter={StaticResource ThemePreviewBrush}, ConverterParameter=card}" />
                                    <Ellipse Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Fill="{Binding Appearance.AccentColor, Converter={StaticResource HexToBrush}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="12.5" FontWeight="Medium" Margin="2,8,0,0" />
                            <TextBlock Text="{Binding Appearance.Theme}" Style="{StaticResource Text.Caption}" Margin="2,1,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Accent ===== -->
        <TextBlock Text="Accent colour" Style="{StaticResource SectionHeader}" Margin="2,8,0,10" />
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding AccentSwatches}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Swatch}" Background="{Binding Converter={StaticResource HexToBrush}}"
                                    ToolTip="{Binding}" AutomationProperties.Name="{Binding StringFormat='Accent {0}'}"
                                    Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{Binding AccentPreview}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" />
                    <TextBox Width="150" Margin="10,0,0,0" FontFamily="{StaticResource Font.Mono}" ui:Ui.Icon="&#xE790;"
                             ui:Ui.Placeholder="#7C6CFF" MaxLength="9" AutomationProperties.Name="Accent HEX"
                             Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding AccentError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Font ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="10,4" ui:Ui.Icon="&#xE777;"
                    Content="Default font" Command="{Binding ResetFontCommand}" />
            <TextBlock Text="Font" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="Search installed fonts"
                             AutomationProperties.Name="Search fonts"
                             Text="{Binding FontSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <Grid>
                        <ListBox Height="232" ItemsSource="{Binding FontsView}" SelectedItem="{Binding SelectedFont}"
                                 AutomationProperties.Name="Fonts">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Loading fonts…" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingFonts, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>

                <!-- Picking a font applies it app-wide, so the preview simply uses the live UI font -->
                <Border Grid.Column="2" Background="{DynamicResource Brush.Input}" CornerRadius="{StaticResource Radius.Control}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding CurrentFontName}" Style="{StaticResource Text.Section}" Margin="0,8,0,0" />
                        <TextBlock Text="Aa Bb Cc 123" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0"
                                   FontFamily="{DynamicResource Font.Primary}" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding PreviewText}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"
                                   FontFamily="{DynamicResource Font.Primary}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBox Margin="0,16,0,0" ui:Ui.Placeholder="Type your own preview text" AutomationProperties.Name="Preview text"
                                 Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                   Text="The whole app switches as soon as you pick a font. Symbol fonts are hidden because they can't display text." />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Language ===== -->
        <TextBlock Text="{DynamicResource L.Language.Header}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xF2B7;" Header="{DynamicResource L.Language.Header}" Description="{DynamicResource L.Language.Description}">
            <ComboBox Width="190" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLanguage}"
                      AutomationProperties.Name="Language" />
        </ui:SettingCard>

        <!-- ===== Roblox font ===== -->
        <TextBlock Text="Roblox font" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8D2;" Header="Use a custom font in Roblox" Description="{Binding RobloxFontStatus}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RobloxFontEnabled}" AutomationProperties.Name="Use a custom font in Roblox" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8E9;" Header="Font for Roblox" Description="{Binding RobloxFontName}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Use my Nexstrap font" Padding="10,6" Command="{Binding UseNexstrapFontForRobloxCommand}" />
                <Button Content="Choose file…" ui:Ui.Icon="&#xE8E5;" Padding="10,6" Margin="6,0,0,0" Command="{Binding ChooseRobloxFontFileCommand}" />
            </StackPanel>
        </ui:SettingCard>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,4,0,0"
                   Text="Only works on Roblox builds Nexstrap installed. Not supported by Roblox, so it may stop working after an update. Takes effect the next time Roblox starts from Nexstrap." />

        <!-- ===== Background ===== -->
        <TextBlock Text="Background" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xEB9F;" Header="Background image"
                        Description="Shown behind the launcher. The image is copied into Nexstrap's data folder.">
            <StackPanel Orientation="Horizontal">
                <Border Width="64" Height="40" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding BackgroundPreview}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Button Content="Choose image…" ui:Ui.Icon="&#xE8E5;" Padding="10,6" Command="{Binding ChooseBackgroundCommand}" />
                <Button Style="{StaticResource Button.Ghost}" Content="Remove" Padding="10,6" Margin="6,0,0,0"
                        Command="{Binding RemoveBackgroundCommand}"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE706;" Header="Opacity" Description="How strongly the image shows through."
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Slider Width="200" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" AutomationProperties.Name="Background opacity"
                        Value="{Binding BackgroundOpacityPercent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BackgroundOpacityPercent, StringFormat='{}{0:0}%'}" Width="40" TextAlignment="Right"
                           Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
            </StackPanel>
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE740;" Header="Sizing" Description="How the image fills the window." Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="210" ItemsSource="{Binding FitChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      AutomationProperties.Name="Background sizing" SelectedValue="{Binding SelectedFit}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE7C8;" Header="Position" Description="Which part of the image stays in view." Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="210" ItemsSource="{Binding AnchorChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      AutomationProperties.Name="Background position" SelectedValue="{Binding SelectedAnchor}" />
        </ui:SettingCard>

        <!-- ===== Saved themes ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="10,4" ui:Ui.Icon="&#xE8B5;"
                    Content="Import theme…" Command="{Binding ImportProfileCommand}" />
            <TextBlock Text="Your themes" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,10"
                           Text="Saves the theme, accent, font and background together. Exported files don't include the image itself." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Save current look" ui:Ui.Icon="&#xE74E;"
                            Margin="10,0,0,0" Command="{Binding SaveProfileCommand}" />
                    <TextBox ui:Ui.Placeholder="Theme name" AutomationProperties.Name="Theme name" MaxLength="48"
                             Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveProfileCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock Text="No saved themes yet." Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                           Visibility="{Binding HasSavedProfiles, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding SavedProfiles}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Apply" Padding="10,5"
                                                Command="{Binding DataContext.ApplySavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xEDE1;" FontFamily="{StaticResource Font.Icons}" Margin="6,0,0,0"
                                                ToolTip="Export…" AutomationProperties.Name="Export"
                                                Command="{Binding DataContext.ExportSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}"
                                                ToolTip="Delete" AutomationProperties.Name="Delete"
                                                Command="{Binding DataContext.DeleteSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                             Fill="{Binding Appearance.AccentColor, Converter={StaticResource HexToBrush}}" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="Medium" />
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding Appearance.Theme, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Appearance.FontFamily, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Reset ===== -->
        <TextBlock Text="Reset" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE777;" Header="Reset appearance"
                        Description="Restore the default theme, accent, font and background. Saved themes are kept.">
            <Button Style="{StaticResource Button.Danger}" Content="Reset" Padding="12,6" Command="{Binding ResetAppearanceCommand}" />
        </ui:SettingCard>
    </StackPanel>
</UserControl>
