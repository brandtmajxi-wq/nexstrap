<UserControl x:Class="Nexstrap.Views.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AppearanceViewModel}">
    <StackPanel>

        <!-- ===== Theme ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.Theme}" Style="{StaticResource SectionHeader}" Margin="2,0,0,10" />
        <UniformGrid Columns="2" Margin="-5,0">
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Theme" IsChecked="{Binding IsDark}" Margin="5"
                         AutomationProperties.Name="Dark theme">
                <StackPanel>
                    <Border Height="74" CornerRadius="8" Background="#0E0F13" BorderBrush="#24252D" BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="#121318" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Height="22" CornerRadius="4" Background="#1C1D24" />
                                <Border Height="10" Width="54" CornerRadius="3" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{DynamicResource L.Appearance.Dark}" Style="{StaticResource Text.Base}" FontWeight="Medium" Margin="2,10,0,0" />
                    <TextBlock Text="{DynamicResource L.Appearance.CharcoalSurfacesEasyOnTheEyes}" Style="{StaticResource Text.Caption}" Margin="2,2,0,0" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Theme" IsChecked="{Binding IsLight}" Margin="5"
                         AutomationProperties.Name="{DynamicResource L.Home.LightTheme}">
                <StackPanel>
                    <Border Height="74" CornerRadius="8" Background="#F4F5F8" BorderBrush="#E1E3EA" BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="#ECEDF2" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Height="22" CornerRadius="4" Background="#FFFFFF" />
                                <Border Height="10" Width="54" CornerRadius="3" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{DynamicResource L.Appearance.Light}" Style="{StaticResource Text.Base}" FontWeight="Medium" Margin="2,10,0,0" />
                    <TextBlock Text="{DynamicResource L.Appearance.BrightAndCrispForDaytime}" Style="{StaticResource Text.Caption}" Margin="2,2,0,0" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- ===== Presets ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.Presets}" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="{DynamicResource L.Appearance.APresetChangesTheThemeAnd}"
                   Style="{StaticResource Text.Caption}" Margin="2,-4,0,10" />
        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource TileButton}" Width="132" Margin="0,0,10,10" Padding="8"
                            AutomationProperties.Name="{Binding Name, StringFormat='Preset {0}'}"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <Border Height="44" CornerRadius="6"
                                    Background="{Binding Appearance.Theme, Converter={StaticResource ThemePreviewBrush}}">
                                <Grid Margin="7">
                                    <Border CornerRadius="3" Width="46" HorizontalAlignment="Left"
                                            Background="{Binding Appearance.Theme, Converter={StaticResource ThemePreviewBrush}, ConverterParameter=card}" />
                                    <Ellipse Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Fill="{Binding Appearance.AccentColor, Converter={StaticResource HexToBrush}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="12.5" FontWeight="Medium" Margin="2,8,0,0" />
                            <TextBlock Text="{Binding Appearance.Theme}" Style="{StaticResource Text.Caption}" Margin="2,1,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Accent ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.AccentColour}" Style="{StaticResource SectionHeader}" Margin="2,8,0,10" />
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding AccentSwatches}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Swatch}" Background="{Binding Converter={StaticResource HexToBrush}}"
                                    ToolTip="{Binding}" AutomationProperties.Name="{Binding StringFormat='Accent {0}'}"
                                    Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{Binding AccentPreview}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" />
                    <TextBox Width="150" Margin="10,0,0,0" FontFamily="{StaticResource Font.Mono}" ui:Ui.Icon="&#xE790;"
                             ui:Ui.Placeholder="#7C6CFF" MaxLength="9" AutomationProperties.Name="Accent HEX"
                             Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding AccentError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Design ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.Design}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE7F4;" Header="{DynamicResource L.Appearance.Corners}" Description="{DynamicResource L.Appearance.Corners.Text}">
            <ComboBox Width="190" ItemsSource="{Binding CornerChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Corners}" AutomationProperties.Name="{DynamicResource L.Appearance.Corners}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE7F4;" Header="{DynamicResource L.Appearance.Cards}" Description="{DynamicResource L.Appearance.Cards.Text}">
            <ComboBox Width="190" ItemsSource="{Binding CardChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Cards}" AutomationProperties.Name="{DynamicResource L.Appearance.Cards}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE790;" Header="{DynamicResource L.Appearance.SidebarTone}" Description="{DynamicResource L.Appearance.SidebarTone.Text}">
            <ComboBox Width="190" ItemsSource="{Binding SidebarToneChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SidebarColour}" AutomationProperties.Name="{DynamicResource L.Appearance.SidebarTone}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE700;" Header="{DynamicResource L.Appearance.IconSidebar}" Description="{DynamicResource L.Appearance.IconSidebar.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IconSidebar}" AutomationProperties.Name="Icons-only sidebar" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE790;" Header="{DynamicResource L.Appearance.GradientButtons}" Description="{DynamicResource L.Appearance.GradientButtons.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GradientButtons}" AutomationProperties.Name="Gradient buttons" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE790;" Header="{DynamicResource L.Appearance.GradientColour}" Description="{DynamicResource L.Appearance.GradientColour.Text}"
                        Visibility="{Binding GradientButtons, Converter={StaticResource BoolToVisibility}}">
            <TextBox Width="150" FontFamily="{StaticResource Font.Mono}" MaxLength="9" AutomationProperties.Name="Gradient second colour"
                     Text="{Binding GradientColour, UpdateSourceTrigger=LostFocus}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE768;" Header="{DynamicResource L.Appearance.Transition}" Description="{DynamicResource L.Appearance.Transition.Text}">
            <ComboBox Width="190" ItemsSource="{Binding TransitionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Transition}" AutomationProperties.Name="{DynamicResource L.Appearance.Transition}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xEB9F;" Header="{DynamicResource L.Appearance.Blur}" Description="{DynamicResource L.Appearance.Blur.Text}"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <Slider Width="190" Minimum="0" Maximum="{Binding MaxBlur}" VerticalAlignment="Center" Value="{Binding BackgroundBlur, Delay=200}" AutomationProperties.Name="{DynamicResource L.Appearance.Blur}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8D2;" Header="{DynamicResource L.Appearance.BrandName}" Description="{DynamicResource L.Appearance.BrandName.Text}">
            <TextBox Width="190" MaxLength="{Binding BrandLimit}" AutomationProperties.Name="{DynamicResource L.Appearance.BrandName}" Text="{Binding BrandName, UpdateSourceTrigger=LostFocus}" />
        </ui:SettingCard>
        <TextBlock Text="{Binding DesignError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="2,0,0,6"
                   Visibility="{Binding DesignError, Converter={StaticResource NullToVisibility}}" />
        <ui:SettingCard Icon="&#xE8B9;" Header="{DynamicResource L.Appearance.BrandLogo}" Description="{DynamicResource L.Appearance.BrandLogo.Text}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource L.Appearance.ChooseImage}" ui:Ui.Icon="&#xE8E5;" Padding="10,6" Command="{Binding ChooseBrandLogoCommand}" />
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Appearance.Remove}" Padding="10,6" Margin="6,0,0,0" Command="{Binding RemoveBrandLogoCommand}"
                        Visibility="{Binding HasBrandLogo, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8D2;" Header="{DynamicResource L.Appearance.ShowTagline}" Description="{DynamicResource L.Appearance.ShowTagline.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowTagline}" AutomationProperties.Name="Show tagline" />
        </ui:SettingCard>

        <!-- ===== Font ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="10,4" ui:Ui.Icon="&#xE777;"
                    Content="{DynamicResource L.Appearance.DefaultFont}" Command="{Binding ResetFontCommand}" />
            <TextBlock Text="{DynamicResource L.Appearance.Font}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="{DynamicResource L.Appearance.SearchInstalledFonts}"
                             AutomationProperties.Name="Search fonts"
                             Text="{Binding FontSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <Grid>
                        <ListBox Height="232" ItemsSource="{Binding FontsView}" SelectedItem="{Binding SelectedFont}"
                                 AutomationProperties.Name="Fonts">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{DynamicResource L.Appearance.LoadingFonts}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingFonts, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>

                <!-- Picking a font applies it app-wide, so the preview simply uses the live UI font -->
                <Border Grid.Column="2" Background="{DynamicResource Brush.Input}" CornerRadius="{DynamicResource Radius.Control}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Appearance.PREVIEW}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Text="{Binding CurrentFontName}" Style="{StaticResource Text.Section}" Margin="0,8,0,0" />
                        <TextBlock Text="Aa Bb Cc 123" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,0"
                                   FontFamily="{DynamicResource Font.Primary}" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding PreviewText}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"
                                   FontFamily="{DynamicResource Font.Primary}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBox Margin="0,16,0,0" ui:Ui.Placeholder="{DynamicResource L.Appearance.TypeYourOwnPreviewText}" AutomationProperties.Name="Preview text"
                                 Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                   Text="{DynamicResource L.Appearance.TheWholeAppSwitchesAsSoon}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Welcome ===== -->
        <TextBlock Text="{DynamicResource L.Nav.Welcome}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE77B;" Header="{DynamicResource L.Appearance.YourName}" Description="{DynamicResource L.Appearance.YourName.Text}">
            <TextBox Width="190" MaxLength="{Binding NameLimit}" ui:Ui.Placeholder="{DynamicResource L.Welcome.Name.Placeholder}" AutomationProperties.Name="{DynamicResource L.Appearance.YourName}"
                     Text="{Binding YourName, UpdateSourceTrigger=LostFocus}" />
        </ui:SettingCard>
        <TextBlock Text="{Binding YourNameError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   Margin="2,0,0,6" Visibility="{Binding YourNameError, Converter={StaticResource NullToVisibility}}" />

        <!-- ===== Winter theme (dev only for now) ===== -->
        <StackPanel Visibility="{Binding WinterAvailable, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{DynamicResource L.Appearance.Winter}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE9CA;" Header="{DynamicResource L.Appearance.Winter.Christmas}" Description="{DynamicResource L.Appearance.Winter.Christmas.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ChristmasMode}" AutomationProperties.Name="Christmas mode" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE9CA;" Header="{DynamicResource L.Appearance.Winter}" Description="{DynamicResource L.Appearance.Winter.Text}">
            <ComboBox Width="190" ItemsSource="{Binding WinterChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding WinterTheme}" AutomationProperties.Name="{DynamicResource L.Appearance.Winter}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE9CA;" Header="{DynamicResource L.Appearance.Winter.Snow}" Description="{DynamicResource L.Appearance.Winter.Snow.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding WinterSnow}" AutomationProperties.Name="{DynamicResource L.Appearance.Winter.Snow}" />
        </ui:SettingCard>

        </StackPanel>

        <!-- ===== App size ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.AppSize}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8A3;" Header="{DynamicResource L.Appearance.AppSize}" Description="{DynamicResource L.Appearance.AppSize.Text}">
            <ComboBox Width="190" ItemsSource="{Binding ScaleChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding UiScale}" AutomationProperties.Name="{DynamicResource L.Appearance.AppSize}" />
        </ui:SettingCard>

        <!-- ===== Sidebar ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Appearance.Sidebar.Reset}" ui:Ui.Icon="&#xE72C;" Padding="10,4"
                    Command="{Binding ResetSidebarCommand}" />
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Appearance.Sidebar}" Style="{StaticResource Text.Section}" />
                <TextBlock Text="{DynamicResource L.Appearance.Sidebar.Text}" Style="{StaticResource Text.Caption}" Margin="0,2,12,0" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,8">
            <ItemsControl ItemsSource="{Binding SidebarRows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Shown}" IsEnabled="{Binding CanHide}" Margin="12,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE70D;" FontFamily="{StaticResource Font.Icons}" Margin="4,0,0,0"
                                    ToolTip="{DynamicResource L.Appearance.Sidebar.Down}" AutomationProperties.Name="{DynamicResource L.Appearance.Sidebar.Down}"
                                    Command="{Binding DataContext.MoveSidebarDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE70E;" FontFamily="{StaticResource Font.Icons}"
                                    ToolTip="{DynamicResource L.Appearance.Sidebar.Up}" AutomationProperties.Name="{DynamicResource L.Appearance.Sidebar.Up}"
                                    Command="{Binding DataContext.MoveSidebarUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ===== Language ===== -->
        <TextBlock Text="{DynamicResource L.Language.Header}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xF2B7;" Header="{DynamicResource L.Language.Header}" Description="{DynamicResource L.Language.Description}">
            <ComboBox Width="190" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLanguage}"
                      AutomationProperties.Name="{DynamicResource L.Language.Header}" />
        </ui:SettingCard>

        <!-- ===== Roblox font ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.RobloxFont}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8D2;" Header="{DynamicResource L.Appearance.UseACustomFontInRoblox}" Description="{Binding RobloxFontStatus}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RobloxFontEnabled}" AutomationProperties.Name="{DynamicResource L.Appearance.UseACustomFontInRoblox}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8E9;" Header="{DynamicResource L.Appearance.FontForRoblox}" Description="{Binding RobloxFontName}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource L.Appearance.UseMyNexstrapFont}" Padding="10,6" Command="{Binding UseNexstrapFontForRobloxCommand}" />
                <Button Content="{DynamicResource L.Appearance.ChooseFile}" ui:Ui.Icon="&#xE8E5;" Padding="10,6" Margin="6,0,0,0" Command="{Binding ChooseRobloxFontFileCommand}" />
            </StackPanel>
        </ui:SettingCard>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,4,0,0"
                   Text="{DynamicResource L.Appearance.OnlyWorksOnRobloxBuildsNexstrap}" />

        <!-- ===== Roblox sound and cursor ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.RobloxMods}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE767;" Header="{DynamicResource L.Appearance.DeathSound}" Description="{Binding DeathSoundName}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource L.Appearance.ChooseFile}" ui:Ui.Icon="&#xE8E5;" Padding="10,6" Command="{Binding ChooseDeathSoundCommand}" />
                <Button Content="{DynamicResource L.Appearance.Remove}" Padding="10,6" Margin="6,0,0,0" Command="{Binding RemoveDeathSoundCommand}"
                        Visibility="{Binding HasDeathSound, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE962;" Header="{DynamicResource L.Appearance.Cursor}" Description="{Binding CursorName}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource L.Appearance.ChooseFile}" ui:Ui.Icon="&#xE8E5;" Padding="10,6" Command="{Binding ChooseCursorCommand}" />
                <Button Content="{DynamicResource L.Appearance.Remove}" Padding="10,6" Margin="6,0,0,0" Command="{Binding RemoveCursorCommand}"
                        Visibility="{Binding HasCursor, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:SettingCard>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,4,0,0" Text="{DynamicResource L.Appearance.ModsNote}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,4,0,0" Foreground="{DynamicResource Brush.Warning}"
                   Text="{DynamicResource L.Appearance.ModsNeedNexstrapBuild}"
                   Visibility="{Binding ModsWontApply, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===== Background ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.Background}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xEB9F;" Header="{DynamicResource L.Appearance.BackgroundImage}"
                        Description="{DynamicResource L.Appearance.ShownBehindTheLauncherTheImage}">
            <StackPanel Orientation="Horizontal">
                <Border Width="64" Height="40" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding BackgroundPreview}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Button Content="{DynamicResource L.Appearance.ChooseImage}" ui:Ui.Icon="&#xE8E5;" Padding="10,6" Command="{Binding ChooseBackgroundCommand}" />
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Appearance.Remove}" Padding="10,6" Margin="6,0,0,0"
                        Command="{Binding RemoveBackgroundCommand}"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE706;" Header="{DynamicResource L.Appearance.Opacity}" Description="{DynamicResource L.Appearance.HowStronglyTheImageShowsThrough}"
                        Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Slider Width="200" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" AutomationProperties.Name="Background opacity"
                        Value="{Binding BackgroundOpacityPercent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BackgroundOpacityPercent, StringFormat='{}{0:0}%'}" Width="40" TextAlignment="Right"
                           Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
            </StackPanel>
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE740;" Header="{DynamicResource L.Appearance.Sizing}" Description="{DynamicResource L.Appearance.HowTheImageFillsTheWindow}" Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="250" ItemsSource="{Binding FitChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      AutomationProperties.Name="Background sizing" SelectedValue="{Binding SelectedFit}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE7C8;" Header="{DynamicResource L.Appearance.Position}" Description="{DynamicResource L.Appearance.WhichPartOfTheImageStays}" Visibility="{Binding HasBackground, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="250" ItemsSource="{Binding AnchorChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      AutomationProperties.Name="Background position" SelectedValue="{Binding SelectedAnchor}" />
        </ui:SettingCard>

        <!-- ===== Saved themes ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="10,4" ui:Ui.Icon="&#xE8B5;"
                    Content="{DynamicResource L.Appearance.ImportTheme}" Command="{Binding ImportProfileCommand}" />
            <TextBlock Text="{DynamicResource L.Appearance.YourThemes}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,10"
                           Text="{DynamicResource L.Appearance.SavesTheThemeAccentFontAnd}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Appearance.SaveCurrentLook}" ui:Ui.Icon="&#xE74E;"
                            Margin="10,0,0,0" Command="{Binding SaveProfileCommand}" />
                    <TextBox ui:Ui.Placeholder="{DynamicResource L.Appearance.ThemeName}" AutomationProperties.Name="{DynamicResource L.Appearance.ThemeName}" MaxLength="48"
                             Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveProfileCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock Text="{DynamicResource L.Appearance.NoSavedThemesYet}" Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                           Visibility="{Binding HasSavedProfiles, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding SavedProfiles}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="{DynamicResource L.Appearance.Apply}" Padding="10,5"
                                                Command="{Binding DataContext.ApplySavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xEDE1;" FontFamily="{StaticResource Font.Icons}" Margin="6,0,0,0"
                                                ToolTip="{DynamicResource L.FastFlags.Export}" AutomationProperties.Name="Export"
                                                Command="{Binding DataContext.ExportSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}"
                                                ToolTip="{DynamicResource L.Appearance.Delete}" AutomationProperties.Name="Delete"
                                                Command="{Binding DataContext.DeleteSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                             Fill="{Binding Appearance.AccentColor, Converter={StaticResource HexToBrush}}" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="Medium" />
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding Appearance.Theme, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Appearance.FontFamily, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Reset ===== -->
        <TextBlock Text="{DynamicResource L.Appearance.Reset}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE777;" Header="{DynamicResource L.Appearance.ResetAppearance}"
                        Description="{DynamicResource L.Appearance.RestoreTheDefaultThemeAccentFont}">
            <Button Style="{StaticResource Button.Danger}" Content="{DynamicResource L.Appearance.Reset}" Padding="12,6" Command="{Binding ResetAppearanceCommand}" />
        </ui:SettingCard>
    </StackPanel>
</UserControl>
