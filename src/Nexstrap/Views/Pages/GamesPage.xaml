<UserControl x:Class="Nexstrap.Views.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:GamesViewModel}">
    <UserControl.Resources>
        <!-- One tile for both lists -->
        <DataTemplate x:Key="GameTile" DataType="{x:Type vm:GameItem}">
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Games.Play}" ui:Ui.Icon="&#xE768;" Padding="12,5"
                                AutomationProperties.Name="{Binding Name, StringFormat='Play {0}'}"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE968;" FontFamily="{StaticResource Font.Icons}" Margin="6,0,0,0" ToolTip="{DynamicResource L.Games.ViewServers}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Servers for {0}'}"
                                Command="{Binding DataContext.ViewServersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE71B;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.CreateDesktopShortcut}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Shortcut for {0}'}"
                                Command="{Binding DataContext.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE70B;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.Note}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Note for {0}'}"
                                Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE713;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.Profile.Add}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Profile for {0}'}"
                                Command="{Binding DataContext.AddProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.Favorite}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Favorite {0}'}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Content" Value="&#xE734;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Content" Value="&#xE735;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource Brush.Hover}" ClipToBounds="True" Margin="0,0,12,0">
                        <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Creator, Converter={StaticResource LocFormat}, ConverterParameter=Format.By}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   Visibility="{Binding Creator, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{Binding PlayedText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   Visibility="{Binding PlayedText, Converter={StaticResource NullToVisibility}}" />
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding ShowsNote, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE70B;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,6,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBox Margin="0,6,0,0" MaxLength="200" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{DynamicResource L.Games.Note.Placeholder}"
                                 AutomationProperties.Name="{DynamicResource L.Games.Note}"
                                 Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVisibility}}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The new look (DEV only for now): a picture card per game, three to a row -->
        <DataTemplate x:Key="GameCard" DataType="{x:Type vm:GameItem}">
            <Border x:Name="Bd" Style="{StaticResource Card}" Padding="0" Margin="5" ClipToBounds="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Lift" />
                </Border.RenderTransform>
                <StackPanel>
                    <!-- Picture, with Play on top of it -->
                    <Grid Height="132">
                        <Border Background="{DynamicResource Brush.Hover}" CornerRadius="11,11,0,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" FontSize="30" Opacity="0.35" />
                                <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border VerticalAlignment="Bottom" Height="60">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#99000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Games.Play}" ui:Ui.Icon="&#xE768;" Padding="14,6"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                AutomationProperties.Name="{Binding Name, StringFormat='Play {0}'}"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.Favorite}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                AutomationProperties.Name="{Binding Name, StringFormat='Favorite {0}'}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Content" Value="&#xE734;" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#66000000" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Content" Value="&#xE735;" />
                                            <Setter Property="Foreground" Value="#FFD54A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Name, details, note -->
                    <StackPanel Margin="12,10,12,4">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Creator, Converter={StaticResource LocFormat}, ConverterParameter=Format.By}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{Binding Creator, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{Binding PlayedText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" Foreground="{DynamicResource Brush.Accent}"
                                   Visibility="{Binding PlayedText, Converter={StaticResource NullToVisibility}}" />
                        <DockPanel Margin="0,5,0,0" Visibility="{Binding ShowsNote, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE70B;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,6,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBox Margin="0,6,0,0" MaxLength="200" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{DynamicResource L.Games.Note.Placeholder}"
                                 AutomationProperties.Name="{DynamicResource L.Games.Note}"
                                 Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVisibility}}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- Other actions -->
                    <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE968;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.ViewServers}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Servers for {0}'}"
                                Command="{Binding DataContext.ViewServersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE71B;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.CreateDesktopShortcut}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Shortcut for {0}'}"
                                Command="{Binding DataContext.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE70B;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.Note}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Note for {0}'}"
                                Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE713;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Games.Profile.Add}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Profile for {0}'}"
                                Command="{Binding DataContext.AddProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="{StaticResource Motion.Fast}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Normal}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Lists of games: rows normally, picture cards in the new look -->
        <Style x:Key="GameList" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource GameTile}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseNewLook}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource GameCard}" />
                    <Setter Property="Margin" Value="-5,0,-5,6" />
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== Search ===== -->
        <TextBlock Text="{DynamicResource L.Games.FindAGame}" Style="{StaticResource SectionHeader}" Margin="2,0,0,10" />
        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Games.Search}" ui:Ui.Icon="&#xE721;"
                            Margin="10,0,0,0" Command="{Binding SearchCommand}" />
                    <TextBox ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="{DynamicResource L.Games.SearchPlaceholder}" AutomationProperties.Name="{DynamicResource L.Games.FindAGame}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0"
                           Visibility="{Binding SearchStatus, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding SearchResults}" Style="{StaticResource GameList}" />

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Games.AddFavorite}" ui:Ui.Icon="&#xE734;"
                            Margin="10,0,0,0" Command="{Binding AddFavoriteCommand}" />
                    <TextBox ui:Ui.Icon="&#xE71B;" ui:Ui.Placeholder="{DynamicResource L.Games.PlaceIDOrRobloxComGames}" AutomationProperties.Name="Favorite place"
                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddFavoriteCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0"
                           Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Games.Surprise}" ui:Ui.Icon="&#xE8B1;" Padding="10,4"
                    VerticalAlignment="Bottom" Margin="0,0,0,8" Command="{Binding SurpriseCommand}"
                    Visibility="{Binding CanSurprise, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{DynamicResource L.Games.Favorites}" Style="{StaticResource SectionHeader}" />
        </DockPanel>
        <TextBlock Text="{DynamicResource L.Games.NoFavoritesYetAddOneAbove}" Style="{StaticResource Text.Caption}" Margin="2,0,0,6"
                   Visibility="{Binding HasFavorites, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Favorites}" Style="{StaticResource GameList}" />

        <TextBlock Text="{DynamicResource L.Games.RecentlyPlayed}" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="{DynamicResource L.Games.GamesYouStartFromNexstrapAppear}" Style="{StaticResource Text.Caption}" Margin="2,0,0,6"
                   Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Recent}" Style="{StaticResource GameList}" />

        <!-- ===== Play history ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Games.ClearHistory}" ui:Ui.Icon="&#xE74D;" Padding="10,4"
                    Command="{Binding ClearHistoryCommand}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Games.ExportHistory}" ui:Ui.Icon="&#xEDE1;" Padding="10,4" Margin="0,0,6,0"
                    Command="{Binding ExportHistoryCommand}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{DynamicResource L.Games.PlayHistory}" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,14" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryThisWeek}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HistorySummary}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryRow}">
                            <DockPanel Margin="0,5">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
                                    <!-- New look: how this game's time compares with your most played one -->
                                    <ProgressBar Height="4" Margin="0,5,0,0" Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                                 Visibility="{Binding DataContext.UseNewLook, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TextBlock Text="{DynamicResource L.Games.NoHistoryYet}" Style="{StaticResource Text.Caption}" Margin="2,0,0,6"
                   Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}" />
        <ui:SettingCard Icon="&#xE81C;" Margin="0,8,0,0" Header="{DynamicResource L.Games.RecordHistory}" Description="{DynamicResource L.Games.RecordHistory.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RecordHistory}" AutomationProperties.Name="{DynamicResource L.Games.RecordHistory}" />
        </ui:SettingCard>

        <!-- ===== Game profiles ===== -->
        <TextBlock Text="{DynamicResource L.Games.Profiles}" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="{DynamicResource L.Games.Profiles.Text}" Style="{StaticResource Text.Caption}" Margin="2,-4,0,10" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource L.Games.Profiles.Empty}" Style="{StaticResource Text.Secondary}" Margin="2,0,0,8"
                   Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding ProfileRows}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox Width="140" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Fps}" AutomationProperties.Name="{Binding Name, StringFormat='FPS for {0}'}"
                                          ItemsSource="{Binding DataContext.FpsChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <ComboBox Width="150" Margin="8,0,0,0" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Quality}" AutomationProperties.Name="{Binding Name, StringFormat='Quality for {0}'}"
                                          ItemsSource="{Binding DataContext.QualityChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}" Margin="6,0,0,0" ToolTip="{DynamicResource L.Appearance.Remove}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Remove profile for {0}'}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
