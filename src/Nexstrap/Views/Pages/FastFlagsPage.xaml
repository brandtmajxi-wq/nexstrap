<UserControl x:Class="Nexstrap.Views.Pages.FastFlagsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FastFlagsViewModel}">
    <StackPanel>

        <!-- ===== Honest status ===== -->
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="{DynamicResource L.FastFlags.RobloxsAnnouncement}" FontSize="12"
                            VerticalAlignment="Top" Command="{Binding OpenAllowlistCommand}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource L.FastFlags.RobloxsAllowlist}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding AllowlistText}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />

                <Border Style="{StaticResource Divider}" Margin="0,12" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource L.FastFlags.GoToHome}" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center"
                            Command="{Binding GoHomeCommand}"
                            Visibility="{Binding TargetIsNexstrap, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                <Setter Property="Text" Value="&#xE7BA;" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetIsNexstrap}" Value="True">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding TargetText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== Add ===== -->
        <TextBlock Text="{DynamicResource L.FastFlags.AddAFlag}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox FontFamily="{StaticResource Font.Mono}" ui:Ui.Placeholder="{DynamicResource L.FastFlags.FlagNameEGFIntDebugForceMSAASamples}"
                             AutomationProperties.Name="New flag name" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Grid.Column="2" FontFamily="{StaticResource Font.Mono}" ui:Ui.Placeholder="{DynamicResource L.FastFlags.Value}"
                             AutomationProperties.Name="New flag value" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="4" Style="{StaticResource Button.Primary}" Content="{DynamicResource L.FastFlags.Add}" ui:Ui.Icon="&#xE710;" Command="{Binding AddCommand}" />
                </Grid>
                <TextBlock Text="{Binding AddError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="2,8,0,0"
                           Visibility="{Binding AddError, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding NewNameHint}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0"
                           Visibility="{Binding NewNameHint, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ===== Your flags ===== -->
        <DockPanel Margin="2,18,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.FastFlags.ImportFile}" ui:Ui.Icon="&#xE8B5;" Padding="10,4" Command="{Binding ImportFileCommand}" />
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.FastFlags.ImportFromRobloxBuild}" ui:Ui.Icon="&#xE896;" Padding="10,4"
                        Command="{Binding ImportFromInstallationCommand}" IsEnabled="{Binding CanImportFromTarget}"
                        ToolTip="{DynamicResource L.FastFlags.ImportFromBuildHint}" />
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.FastFlags.Export}" ui:Ui.Icon="&#xEDE1;" Padding="10,4" Command="{Binding ExportCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{DynamicResource L.FastFlags.YourFlags}" Style="{StaticResource Text.Section}" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Margin="2,0,0,10"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBox ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="{DynamicResource L.FastFlags.SearchYourFlags}" AutomationProperties.Name="Search flags"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Filter}" AutomationProperties.Name="Filter flags" />
                </Grid>

                <TextBlock Text="{DynamicResource L.FastFlags.NoFlagsYetAddOneAbove}"
                           Style="{StaticResource Text.Caption}" Margin="0,14,0,2"
                           Visibility="{Binding HasFlags, Converter={StaticResource InverseBoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding RowsView}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" Margin="0,0,14,0"
                                              AutomationProperties.Name="{Binding Name, StringFormat='Enable {0}'}" ToolTip="{DynamicResource L.FastFlags.Enabled}" />

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                                                       Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                            <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,1" Background="{DynamicResource Brush.Hover}">
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Text.Caption}" FontSize="10.5" />
                                            </Border>
                                            <Border Margin="6,0,0,0" CornerRadius="4" Padding="5,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAllowlisted}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Primary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding ValueError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                                   Margin="0,3,0,0" Visibility="{Binding ValueError, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>

                                    <!-- Bool flags get a toggle; others a validated text box (Enter or leaving the box saves) -->
                                    <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Left"
                                              AutomationProperties.Name="{Binding Name, StringFormat='Value of {0}'}"
                                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding EditValue}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" />
                                    </CheckBox>
                                    <TextBox Grid.Column="2" FontFamily="{StaticResource Font.Mono}" Padding="8,5"
                                             AutomationProperties.Name="{Binding Name, StringFormat='Value of {0}'}"
                                             Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsBool, Converter={StaticResource InverseBoolToVisibility}}"
                                             LostKeyboardFocus="OnValueLostFocus">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding CommitValueCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}"
                                            Margin="8,0,0,0" ToolTip="{DynamicResource L.Appearance.Delete}" AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Known flags ===== -->
        <TextBlock Text="{DynamicResource L.FastFlags.KnownFlags}" Style="{StaticResource SectionHeader}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,-4,0,10"
                   Text="{DynamicResource L.FastFlags.RobloxDoesntDocumentTheseFlagsDescriptions}" />
        <Border Style="{StaticResource Card}" Padding="18,6">
            <ItemsControl ItemsSource="{Binding KnownFlags}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.FastFlags.Add}" ui:Ui.Icon="&#xE710;" Padding="10,5" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Flag.Name, StringFormat='Add {0}'}"
                                        IsEnabled="{Binding CanAdd}"
                                        Command="{Binding DataContext.AddKnownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Flag.Name}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Flag.LocalizedCategory, StringFormat=' · {0}'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource L.FastFlags.Added}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Flag.LocalizedDescription}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Flag.Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0"
                                               Visibility="{Binding Flag.Note, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ===== Backups & reset ===== -->
        <TextBlock Text="{DynamicResource L.FastFlags.Backups}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}"
                           Text="{DynamicResource L.FastFlags.ABackupIsSavedAutomaticallyBefore}" />
                <TextBlock Text="{DynamicResource L.FastFlags.NoBackupsYet}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                           Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Backups}" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,6">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.FastFlags.Restore}" Padding="10,4"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center">
                                    <Run Text="{Binding CreatedLocal, Mode=OneWay, StringFormat='{}{0:g}'}" />
                                    <Run Text="·" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <Run Text="{Binding Reason, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <Run Text="·" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <Run Text="{Binding FlagCount, Mode=OneWay, Converter={StaticResource LocFormat}, ConverterParameter=Format.FlagCount}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ui:SettingCard Icon="&#xE777;" Header="{DynamicResource L.FastFlags.RemoveAllFlags}" Description="{DynamicResource L.FastFlags.RobloxGoesBackToItsDefaults}"
                        Margin="0,12,0,0">
            <Button Style="{StaticResource Button.Danger}" Content="{DynamicResource L.FastFlags.RemoveAll}" Padding="12,6" Command="{Binding ResetCommand}" />
        </ui:SettingCard>
    </StackPanel>
</UserControl>
