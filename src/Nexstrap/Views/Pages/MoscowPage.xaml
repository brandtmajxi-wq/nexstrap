<UserControl x:Class="Nexstrap.Views.Pages.MoscowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MoscowViewModel}">
    <Grid>
        <Grid.Resources>
            <!-- Matches the app's text boxes; WPF's own PasswordBox is a plain white box -->
            <Style TargetType="PasswordBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- Locked: a password box -->
        <StackPanel Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Style="{StaticResource Card}" Padding="22,20" Width="440" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource L.Secret.Locked}" Style="{StaticResource Text.Section}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource L.Secret.Locked.Text}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="UnlockButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{DynamicResource L.Secret.Unlock}"
                                Padding="14,6" Margin="8,0,0,0" Click="OnUnlock" />
                        <PasswordBox x:Name="Password" KeyDown="OnKeyDown" AutomationProperties.Name="{DynamicResource L.Secret.Password}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="2,6,0,0"
                               Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Legal.Back}" HorizontalAlignment="Left" Padding="10,4" Margin="0,14,0,0"
                            Command="{Binding BackCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Unlocked: Moscow -->
        <StackPanel Margin="4,44,0,0" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
            <StackPanel TextBlock.Foreground="White">
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.55" Color="Black" />
                </StackPanel.Effect>
                <StackPanel Orientation="Horizontal">
                    <!-- The Russian flag: white, blue, red -->
                    <Border Width="54" Height="36" CornerRadius="3" ClipToBounds="True" BorderBrush="#40000000" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Rectangle Fill="White" />
                            <Rectangle Grid.Row="1" Fill="#0039A6" />
                            <Rectangle Grid.Row="2" Fill="#D52B1E" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Greeting}" FontFamily="{DynamicResource Font.Primary}" FontSize="36" FontWeight="SemiBold" Margin="16,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding MoscowTime}" FontFamily="{DynamicResource Font.Primary}" FontSize="80" FontWeight="Bold" Margin="0,2,0,0" />
                <TextBlock Text="{Binding MoscowDate}" FontFamily="{DynamicResource Font.Primary}" FontSize="18" />
                <TextBlock Text="{Binding LocalTime}" FontFamily="{DynamicResource Font.Primary}" FontSize="14" Opacity="0.85" Margin="0,4,0,0" />
            </StackPanel>
            <WrapPanel Margin="0,26,0,0">
                <Button Style="{StaticResource Button.Primary}" Content="{Binding ThemeButton}" Padding="16,8" Margin="0,0,10,6" Command="{Binding ApplyThemeCommand}" />
                <Button Content="{DynamicResource L.Legal.Back}" Padding="16,8" Margin="0,0,0,6" Command="{Binding BackCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding ThemeMessage}" Foreground="White" FontSize="13" Margin="2,4,0,0"
                       Visibility="{Binding ThemeMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
