<UserControl x:Class="Nexstrap.Views.Pages.IntegrationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:IntegrationsViewModel}">
    <StackPanel>
        <TextBlock Text="Discord" Style="{StaticResource SectionHeader}" Margin="2,0,0,10" />

        <!-- Status + preview mock -->
        <Border Style="{StaticResource Card}" Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Rich Presence" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"
                               Text="{DynamicResource L.Integrations.WhileRobloxRunsFromNexstrapYour}" />
                    <Border Margin="0,14,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Showing">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="NeedsSetup">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="DiscordNotRunning">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                            <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource Font.Primary}" TextWrapping="Wrap" MaxWidth="380" />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding PreviewButtonText}" ui:Ui.Icon="&#xE7B3;" Padding="12,7" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Command="{Binding TogglePreviewCommand}" />
                </StackPanel>

                <!-- What it looks like (static illustration of the menu presence) -->
                <Border Grid.Column="2" CornerRadius="10" Padding="14,12" Background="#1E1F24" BorderBrush="#2B2D33" BorderThickness="1"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Integrations.Playing}" FontSize="12" FontWeight="SemiBold" Foreground="#DBDEE1" FontFamily="{DynamicResource Font.Primary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Width="64" Height="64" CornerRadius="10" Background="#141519">
                                <ContentPresenter Margin="8" ContentTemplate="{StaticResource Template.LogoMark}" Content="{Binding}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Roblox" FontSize="13.5" FontWeight="Bold" Foreground="#F2F3F5" FontFamily="{DynamicResource Font.Primary}" />
                                <TextBlock Text="{Binding MenuTopLine}" FontSize="12.5" Foreground="#DBDEE1" Margin="0,2,0,0" MaxWidth="190"
                                           TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Font.Primary}" />
                                <TextBlock Text="{Binding MenuBottomLine}" FontSize="12.5" Foreground="#DBDEE1" MaxWidth="190"
                                           TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Font.Primary}" />
                                <TextBlock Text="0:12:34" FontSize="12" Foreground="#3BA55D" Margin="0,2,0,0" FontFamily="{DynamicResource Font.Primary}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L.Integrations.TheHeaderShowsYourDiscordApplications}" FontSize="10.5" Foreground="#949BA4" Margin="0,10,0,0"
                                   TextWrapping="Wrap" FontFamily="{DynamicResource Font.Primary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ui:SettingCard Icon="&#xE7FC;" Header="{DynamicResource L.Integrations.ShowActivityOnDiscord}" Description="{DynamicResource L.Integrations.TurnRichPresenceOnOrOff}" Margin="0,10,0,6">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RichPresence}" AutomationProperties.Name="Rich Presence" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8D2;" Header="{DynamicResource L.Integrations.MenuTextFirstLine}"
                        Description="{DynamicResource L.Integrations.ShownWhileYoureInTheRoblox}">
            <TextBox Width="220" MaxLength="128" ui:Ui.Placeholder="Inside Nexstrap" AutomationProperties.Name="Menu text first line"
                     Text="{Binding MenuTopLine, UpdateSourceTrigger=LostFocus}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8D2;" Header="{DynamicResource L.Integrations.MenuTextSecondLine}"
                        Description="{DynamicResource L.Integrations.ForExampleBrowsingZovstrapUpdatesOn}">
            <TextBox Width="220" MaxLength="128" ui:Ui.Placeholder="Browsing Roblox" AutomationProperties.Name="Menu text second line"
                     Text="{Binding MenuBottomLine, UpdateSourceTrigger=LostFocus}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xEB9F;" Header="{DynamicResource L.Integrations.CardIcon}"
                        Description="{DynamicResource L.Integrations.CardIcon.Text}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding UploadImageText}" Padding="10,4" Margin="0,0,8,0" Command="{Binding UploadMenuImageCommand}" />
                <TextBox Width="220" MaxLength="256" ui:Ui.Placeholder="{DynamicResource L.Integrations.BuiltInLogo}" AutomationProperties.Name="{DynamicResource L.Integrations.CardIcon}"
                         Text="{Binding MenuImage, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </ui:SettingCard>
        <TextBlock Text="{Binding MenuImageError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   Margin="2,0,0,6" Visibility="{Binding MenuImageError, Converter={StaticResource NullToVisibility}}" />
        <ui:SettingCard Icon="&#xE8B9;" Header="{DynamicResource L.Integrations.ShowExperienceNameAndIcon}"
                        Description="{DynamicResource L.Integrations.OffKeepsItPrivateDiscordJust}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowExperienceDetails}" AutomationProperties.Name="Show experience details" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE77B;" Header="{DynamicResource L.Integrations.ShowMyAvatarAndUsername}"
                        Description="{DynamicResource L.Integrations.YourRobloxHeadshotSitsInThe}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowAvatar}" AutomationProperties.Name="Show avatar" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE774;" Header="{DynamicResource L.Integrations.ShowServerLocation}"
                        Description="{DynamicResource L.Integrations.ShowServerLocation.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowServerLocation}" AutomationProperties.Name="{DynamicResource L.Integrations.ShowServerLocation}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE71B;" Header="{DynamicResource L.Integrations.ViewGameButton}"
                        Description="{DynamicResource L.Integrations.LetsFriendsOpenTheGamesPage}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowExperienceButton}" AutomationProperties.Name="View game button" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE943;" Header="{DynamicResource L.Integrations.DiscordApplicationID}"
                        Description="{DynamicResource L.Integrations.AdvancedLeaveEmptyToUseNexstraps}">
            <StackPanel>
                <TextBox Width="220" FontFamily="{StaticResource Font.Mono}" ui:Ui.Placeholder="{DynamicResource L.Integrations.BuiltIn}" MaxLength="20"
                         AutomationProperties.Name="{DynamicResource L.Integrations.DiscordApplicationID}"
                         Text="{Binding ApplicationId, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ui:SettingCard>
        <TextBlock Text="{Binding ApplicationIdError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                   Margin="2,0,0,6" Visibility="{Binding ApplicationIdError, Converter={StaticResource NullToVisibility}}" />

        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,12,0,0"
                   Text="{DynamicResource L.Integrations.NexstrapKeepsRunningInTheBackground}" />

        <!-- ===== Companion apps ===== -->
        <DockPanel Margin="2,22,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Integrations.AddProgram}" ui:Ui.Icon="&#xE710;" Padding="10,4"
                    Command="{Binding AddCompanionCommand}" />
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Integrations.StartWithRoblox}" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                           Text="{DynamicResource L.Integrations.ProgramsNexstrapOpensWhenYouStart}" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Integrations.NoProgramsYet}" Style="{StaticResource Text.Caption}" Margin="0,6"
                           Visibility="{Binding HasCompanions, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Companions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" Margin="0,0,14,0" VerticalAlignment="Top"
                                              AutomationProperties.Name="{Binding Name, StringFormat='Enable {0}'}" ToolTip="{DynamicResource L.Integrations.StartWithRoblox}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <TextBlock Text="{DynamicResource L.Integrations.ThisProgramCantBeFoundAnymore}" Style="{StaticResource Text.Caption}"
                                                   Foreground="{DynamicResource Brush.Danger}" Margin="0,2,0,0"
                                                   Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBox Width="220" FontFamily="{StaticResource Font.Mono}" Padding="8,4" ui:Ui.Placeholder="{DynamicResource L.Integrations.ArgumentsOptional}"
                                                     AutomationProperties.Name="{Binding Name, StringFormat='Arguments for {0}'}"
                                                     Text="{Binding Arguments, UpdateSourceTrigger=LostFocus}" />
                                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseWithRoblox}" Margin="16,0,0,0"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Close {0} with Roblox'}">
                                                <TextBlock Text="{DynamicResource L.Integrations.CloseWhenRobloxCloses}" Style="{StaticResource Text.Caption}" FontSize="12" />
                                            </CheckBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="{DynamicResource L.Integrations.Test}" Padding="10,4"
                                                Command="{Binding DataContext.TestCompanionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}" Margin="6,0,0,0"
                                                ToolTip="{DynamicResource L.Appearance.Remove}" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                                                Command="{Binding DataContext.RemoveCompanionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,4"
                           Text="{DynamicResource L.Integrations.CloseWhenRobloxClosesAsksThe}" />
            </StackPanel>
        </Border>

        <!-- ===== Configuration ===== -->
        <TextBlock Text="{DynamicResource L.Integrations.MoveYourSetup}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8F4;" Header="{DynamicResource L.Integrations.ExportOrImportNexstrapsConfiguration}"
                        Description="{DynamicResource L.Integrations.OneFileWithYourAppearanceLaunch}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource L.FastFlags.Export}" ui:Ui.Icon="&#xEDE1;" Padding="10,5" Command="{Binding ExportConfigCommand}" />
                <Button Content="{DynamicResource L.Integrations.Import}" ui:Ui.Icon="&#xE8B5;" Padding="10,5" Margin="6,0,0,0" Command="{Binding ImportConfigCommand}" />
            </StackPanel>
        </ui:SettingCard>
        <TextBlock Text="{Binding TransferMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Margin="2,0,0,6"
                   Visibility="{Binding TransferMessage, Converter={StaticResource NullToVisibility}}" />

        <!-- ===== Multi-instance ===== -->
        <TextBlock Text="{DynamicResource L.Integrations.MultipleRobloxWindows}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,12,0" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource Text.Secondary}" MaxWidth="720"
                           Text="{DynamicResource L.Integrations.NotAvailableTheRobloxPlayerOnly}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
