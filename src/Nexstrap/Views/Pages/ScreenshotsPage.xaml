<UserControl x:Class="Nexstrap.Views.Pages.ScreenshotsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ScreenshotsViewModel}">
    <StackPanel>
        <ui:SettingCard Icon="&#xE714;" Header="{DynamicResource L.Clips}" Description="{DynamicResource L.Clips.Text}" Margin="0,0,0,8"
                        Visibility="{Binding ClipsAvailable, Converter={StaticResource BoolToVisibility}}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RecordClips}" AutomationProperties.Name="{DynamicResource L.Clips}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE916;" Header="{DynamicResource L.Clips.Length}" Description="{DynamicResource L.Clips.Length.Text}" Margin="0,0,0,8"
                        Visibility="{Binding ClipsAvailable, Converter={StaticResource BoolToVisibility}}">
            <ComboBox Width="170" ItemsSource="{Binding ClipLengthChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding ClipSeconds}" AutomationProperties.Name="{DynamicResource L.Clips.Length}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE92E;" Header="{DynamicResource L.Clips.Key}" Description="{DynamicResource L.Clips.Key.Text}" Margin="0,0,0,8"
                        Visibility="{Binding ClipsAvailable, Converter={StaticResource BoolToVisibility}}">
            <Button x:Name="HotkeyButton" MinWidth="170" Padding="12,5" Content="{Binding HotkeyText}" Command="{Binding PickHotkeyCommand}"
                    PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyLostFocus" AutomationProperties.Name="{DynamicResource L.Clips.Key}" />
        </ui:SettingCard>
        <DockPanel Margin="2,0,0,12" Visibility="{Binding ClipsAvailable, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Clips.OpenFolder}" ui:Ui.Icon="&#xE838;" Padding="10,4" Command="{Binding OpenClipsFolderCommand}" />
            <TextBlock Text="{Binding ClipStatus}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <DockPanel Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Screenshots.Refresh}" ui:Ui.Icon="&#xE72C;" Padding="10,4" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Screenshots.OpenFolder}" ui:Ui.Icon="&#xE838;" Padding="10,4" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="18,16" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE722;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,14,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Screenshots.Empty}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L.Screenshots.Empty.Text}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="-5,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScreenshotItem}">
                    <Border x:Name="Tile" Style="{StaticResource Card}" Padding="0" Margin="5" ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <Button Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="{DynamicResource L.Screenshots.OpenTip}"
                                    AutomationProperties.Name="{Binding Taken, StringFormat='Screenshot {0}'}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Height="140" Background="{DynamicResource Brush.Hover}">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <DockPanel Margin="10,6,6,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Screenshots.Copy}"
                                            AutomationProperties.Name="{DynamicResource L.Screenshots.Copy}"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE838;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Screenshots.Show}"
                                            AutomationProperties.Name="{DynamicResource L.Screenshots.Show}"
                                            Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}" ToolTip="{DynamicResource L.Screenshots.Delete}"
                                            AutomationProperties.Name="{DynamicResource L.Screenshots.Delete}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Taken}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <!-- New look: lift and an accent edge on hover -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=Tile}" Value="True" />
                                <Condition Binding="{Binding DataContext.UseNewLook, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="{StaticResource Motion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Normal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
