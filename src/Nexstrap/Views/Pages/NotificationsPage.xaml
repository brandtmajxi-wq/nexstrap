<UserControl x:Class="Nexstrap.Views.Pages.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:NotificationsViewModel}">
    <StackPanel>
        <DockPanel Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Notifications.ShowDismissed}" Padding="10,4" Command="{Binding RestoreDismissedCommand}"
                        Visibility="{Binding HasDismissed, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.Notifications.DismissAll}" Padding="10,4" Margin="6,0,0,0" Command="{Binding DismissAllCommand}"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Text="{DynamicResource L.Notifications.Inbox}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="18,16"
                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,10,0" />
                <TextBlock Text="{DynamicResource L.Notifications.YoureAllCaughtUp}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource L.About.Open}" Padding="10,5" AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Margin="6,0,0,0"
                                        ToolTip="{DynamicResource L.Main.Dismiss}" AutomationProperties.Name="{Binding Title, StringFormat='Dismiss {0}'}"
                                        Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,2,12,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                        <Setter Property="Text" Value="&#xE896;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Body}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{DynamicResource L.Notifications.Preferences}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE895;" Header="{DynamicResource L.Home.NexstrapUpdates}" Description="{DynamicResource L.Notifications.WhenANewerNexstrapIsPublished}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NexstrapUpdates}" AutomationProperties.Name="Notify Nexstrap updates" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE896;" Header="{DynamicResource L.Notifications.RobloxUpdates}" Description="{DynamicResource L.Notifications.WhenRobloxReleasesABuildNewer}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RobloxUpdates}" AutomationProperties.Name="Notify Roblox updates" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE7BA;" Header="{DynamicResource L.Notifications.ConfigurationWarnings}" Description="{DynamicResource L.Notifications.IgnoredFastFlagsFlagsThatCantApply}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ConfigurationWarnings}" AutomationProperties.Name="Notify configuration warnings" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE7FC;" Header="{DynamicResource L.Notifications.GameJoinAlerts}" Description="{DynamicResource L.Notifications.GameJoinAlerts.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GameJoinAlerts}" AutomationProperties.Name="{DynamicResource L.Notifications.GameJoinAlerts}" />
        </ui:SettingCard>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,10,0,0"
                   Text="{DynamicResource L.Notifications.NotificationsAppearInsideNexstrapWhileIts}" />
    </StackPanel>
</UserControl>
