<UserControl x:Class="Nexstrap.Views.Pages.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ServersViewModel}">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Find servers" ui:Ui.Icon="&#xE721;"
                            Margin="10,0,0,0" Command="{Binding LoadCommand}" />
                    <TextBox ui:Ui.Icon="&#xE71B;" ui:Ui.Placeholder="Place ID or roblox.com/games/… link" AutomationProperties.Name="Server place"
                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="{Binding ExperienceName}" Style="{StaticResource Text.Section}" Margin="2,12,0,0"
                           Visibility="{Binding ExperienceName, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0"
                           Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="Filters" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8CB;" Header="Sort by" Description="Roblox provides the player order; ping sorts the servers loaded so far.">
            <ComboBox Width="170" ItemsSource="{Binding SortChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Sort}" AutomationProperties.Name="Sort servers" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE716;" Header="Hide full servers" Description="Only show servers with room to join.">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding HideFull}" AutomationProperties.Name="Hide full servers" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8FA;" Header="Minimum free slots" Description="Useful for joining with friends.">
            <StackPanel Orientation="Horizontal">
                <Slider Width="180" Minimum="0" Maximum="20" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding MinFreeSlots}" AutomationProperties.Name="Minimum free slots" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MinFreeSlots, StringFormat='{}{0:0}'}" Width="40" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
            </StackPanel>
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xEC05;" Header="Maximum ping" Description="0 means no limit. Roblox reports each server's average, not your own ping.">
            <StackPanel Orientation="Horizontal">
                <Slider Width="180" Minimum="0" Maximum="300" SmallChange="10" LargeChange="50" IsSnapToTickEnabled="True" TickFrequency="10"
                        Value="{Binding MaxPing}" AutomationProperties.Name="Maximum ping" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MaxPing, StringFormat='{}{0:0} ms'}" Width="56" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
            </StackPanel>
        </ui:SettingCard>

        <TextBlock Text="Servers" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,6">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ServersView}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Join" ui:Ui.Icon="&#xE768;" Padding="12,5" Margin="14,0,0,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding IsFull, Converter={StaticResource InverseBool}}"
                                            AutomationProperties.Name="{Binding Id, StringFormat='Join {0}'}"
                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding Ping, Mode=OneWay, StringFormat='{}{0} ms', TargetNullValue='no ping'}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Fps, Mode=OneWay, StringFormat='{}{0:0} FPS'}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Base}" FontWeight="Medium">
                                                <Run Text="{Binding Playing, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding MaxPlayers, Mode=OneWay}" /><Run Text=" players" />
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Height="4" Margin="0,7,0,0" Maximum="1" Value="{Binding Fill, Mode=OneWay}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Load more" HorizontalAlignment="Center" Padding="12,5" Margin="0,10"
                        Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,6"
                           Text="Server regions aren't shown: Roblox's public list doesn't include them. Roblox can still move you to another server if this one fills up." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
