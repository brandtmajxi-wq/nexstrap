<UserControl x:Class="Nexstrap.Views.Pages.RobloxSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RobloxSettingsViewModel}">
    <StackPanel>

        <!-- ===== In-game settings ===== -->
        <DockPanel Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.RobloxSettings.Reload}" ui:Ui.Icon="&#xE72C;" Padding="10,4" Command="{Binding RefreshCommand}" />
                <Button Content="{DynamicResource L.RobloxSettings.Discard}" Padding="12,6" Margin="6,0,0,0" Command="{Binding DiscardCommand}" />
                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource L.RobloxSettings.SaveToRoblox}" ui:Ui.Icon="&#xE74E;" Padding="14,6" Margin="8,0,0,0"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{DynamicResource L.RobloxSettings.InGameSettings}" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                           Text="{DynamicResource L.RobloxSettings.TheSameSettingsAsRobloxsOwn}" />
            </StackPanel>
        </DockPanel>

        <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource Brush.WarningSoft}"
                Visibility="{Binding EditBlockedReason, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding EditBlockedReason}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Warning}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Margin="2,0,0,10"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

        <StackPanel IsEnabled="{Binding CanEdit}">
            <ui:SettingCard Icon="&#xEC4A;" Header="{DynamicResource L.Performance.MaximumFrameRate}"
                            Description="{DynamicResource L.RobloxSettings.ACeilingNotABoostRoblox}">
                <ComboBox Width="170" ItemsSource="{Binding FramerateChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding FramerateCap}" AutomationProperties.Name="{DynamicResource L.Performance.MaximumFrameRate}" />
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE7F4;" Header="{DynamicResource L.RobloxSettings.AutomaticGraphicsQuality}"
                            Description="{DynamicResource L.RobloxSettings.LetsRobloxPickTheQualityLevel}">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding QualityAutomatic}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.AutomaticGraphicsQuality}" />
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE91B;" Header="{DynamicResource L.RobloxSettings.GraphicsQuality}"
                            Description="{DynamicResource L.RobloxSettings.1IsTheFastest10The}"
                            Visibility="{Binding QualityAutomatic, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="1" Maximum="10" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding QualityLevel}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.GraphicsQuality}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding QualityLabel}" Width="52" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE740;" Header="{DynamicResource L.RobloxSettings.Fullscreen}" Description="{DynamicResource L.RobloxSettings.StartRobloxInFullscreenInsteadOf}">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Fullscreen}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.Fullscreen}" />
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE767;" Header="{DynamicResource L.RobloxSettings.Volume}" Description="{DynamicResource L.RobloxSettings.RobloxsMasterVolume}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="100" SmallChange="10" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="10"
                            Value="{Binding VolumePercent}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.Volume}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VolumePercent, StringFormat='{}{0:0}%'}" Width="52" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE962;" Header="{DynamicResource L.RobloxSettings.CameraSensitivity}" Description="{DynamicResource L.RobloxSettings.HowFastTheCameraTurnsWith}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0.1" Maximum="4" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.1"
                            Value="{Binding MouseSensitivity}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.CameraSensitivity}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MouseSensitivity, StringFormat='{}{0:0.0}'}" Width="52" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE7AD;" Header="{DynamicResource L.RobloxSettings.InvertCameraVertically}" Description="{DynamicResource L.RobloxSettings.MovingTheMouseUpLooksDown}">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding InvertCamera}" AutomationProperties.Name="Invert camera" />
            </ui:SettingCard>
        </StackPanel>

        <!-- ===== Launch preferences ===== -->
        <TextBlock Text="{DynamicResource L.RobloxSettings.LaunchPreferences}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8BB;" Header="{DynamicResource L.Home.CloseNexstrapAfterLaunch}"
                        Description="{DynamicResource L.RobloxSettings.HideTheLauncherOnceRobloxStarts}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseAfterLaunch}" AutomationProperties.Name="Close after launch" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE71B;" Header="{DynamicResource L.RobloxSettings.OpenWebsitePlayButtonsWithNexstrap}" Description="{Binding LinkHandlerText}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding UseNexstrapForLinks}" IsEnabled="{Binding CanChangeWindowsIntegration}" AutomationProperties.Name="Use Nexstrap for website links" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE7E8;" Header="{DynamicResource L.RobloxSettings.StartWithWindows}" Description="{DynamicResource L.RobloxSettings.StartWithWindows.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeWindowsIntegration}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.StartWithWindows}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE8FC;" Header="{DynamicResource L.RobloxSettings.StartHidden}" Description="{DynamicResource L.RobloxSettings.StartHidden.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartHidden}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.StartHidden}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE921;" Header="{DynamicResource L.RobloxSettings.CloseToTray}" Description="{DynamicResource L.RobloxSettings.CloseToTray.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.CloseToTray}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE765;" Header="{DynamicResource L.RobloxSettings.Hotkeys}" Description="{DynamicResource L.RobloxSettings.Hotkeys.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GlobalHotkeys}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.Hotkeys}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE950;" Header="{DynamicResource L.RobloxSettings.CpuPriority}" Description="{DynamicResource L.RobloxSettings.CpuPriority.Text}">
            <ComboBox Width="190" ItemsSource="{Binding PriorityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding RobloxPriority}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.CpuPriority}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE964;" Header="{DynamicResource L.RobloxSettings.CpuCores}" Description="{DynamicResource L.RobloxSettings.CpuCores.Text}">
            <ComboBox Width="190" ItemsSource="{Binding CoreChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding RobloxCoreLimit}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.CpuCores}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE737;" Header="{DynamicResource L.RobloxSettings.WindowTitle}" Description="{DynamicResource L.RobloxSettings.WindowTitle.Text}">
            <TextBox Width="220" Text="{Binding RobloxWindowTitle}" MaxLength="100" ui:Ui.Placeholder="Roblox"
                     AutomationProperties.Name="{DynamicResource L.RobloxSettings.WindowTitle}" />
        </ui:SettingCard>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,4,0,0" Text="{DynamicResource L.RobloxSettings.TweaksNote}" />

        <!-- ===== Installation ===== -->
        <TextBlock Text="{DynamicResource L.RobloxSettings.Installation}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE7B8;" Header="{DynamicResource L.RobloxSettings.RobloxBuild}" Description="{Binding InstallationText}">
            <Button Content="{DynamicResource L.RobloxSettings.ManageOnHome}" Padding="10,5" Command="{Binding ManageInstallationsCommand}" />
        </ui:SettingCard>

        <!-- ===== Backups ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{DynamicResource L.RobloxSettings.BackUpNow}" ui:Ui.Icon="&#xE74E;" Padding="10,4"
                    Command="{Binding BackupNowCommand}" />
            <StackPanel>
                <TextBlock Text="{DynamicResource L.RobloxSettings.BackupsOfRobloxsSettings}" Style="{StaticResource Text.Section}" />
                <TextBlock Text="{DynamicResource L.RobloxSettings.MadeAutomaticallyBeforeEverySaveOr}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.FastFlags.NoBackupsYet}" Style="{StaticResource Text.Caption}" Margin="0,4"
                           Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,5">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.FastFlags.Restore}" Padding="10,4"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding CreatedLocal, StringFormat='{}{0:g}'}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Advanced ===== -->
        <TextBlock Text="{DynamicResource L.RobloxSettings.Advanced}" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8B7;" Header="{DynamicResource L.RobloxSettings.RobloxsSettingsFolder}" Description="{DynamicResource L.RobloxSettings.WhereGlobalBasicSettings13XmlLives}">
            <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE838;" Padding="10,5" Command="{Binding OpenSettingsFolderCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE9F9;" Header="{DynamicResource L.RobloxSettings.RobloxsLogs}" Description="{DynamicResource L.RobloxSettings.UsefulWhenReportingAProblemWith}">
            <Button Content="{DynamicResource L.About.Open}" ui:Ui.Icon="&#xE838;" Padding="10,5" Command="{Binding OpenRobloxLogsCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE74D;" Header="{DynamicResource L.RobloxSettings.CleanOnStart}" Description="{DynamicResource L.RobloxSettings.CleanOnStart.Text}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CleanOldFilesOnStart}" AutomationProperties.Name="{DynamicResource L.RobloxSettings.CleanOnStart}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE81C;" Header="{DynamicResource L.RobloxSettings.CleanNow}" Description="{Binding CleanupDescription}">
            <Button Content="{DynamicResource L.RobloxSettings.CleanNow.Button}" Padding="10,5" Command="{Binding CleanNowCommand}" />
        </ui:SettingCard>
    </StackPanel>
</UserControl>
