<UserControl x:Class="Nexstrap.Views.Pages.RobloxSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Nexstrap.Controls"
             xmlns:vm="clr-namespace:Nexstrap.ViewModels.Pages"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RobloxSettingsViewModel}">
    <StackPanel>

        <!-- ===== In-game settings ===== -->
        <DockPanel Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Content="Reload" ui:Ui.Icon="&#xE72C;" Padding="10,4" Command="{Binding RefreshCommand}" />
                <Button Content="Discard" Padding="12,6" Margin="6,0,0,0" Command="{Binding DiscardCommand}" />
                <Button Style="{StaticResource Button.Primary}" Content="Save to Roblox" ui:Ui.Icon="&#xE74E;" Padding="14,6" Margin="8,0,0,0"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="In-game settings" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                           Text="The same settings as Roblox's own menu. They take effect the next time Roblox starts." />
            </StackPanel>
        </DockPanel>

        <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,10" Background="{DynamicResource Brush.WarningSoft}"
                Visibility="{Binding EditBlockedReason, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding EditBlockedReason}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Warning}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Margin="2,0,0,10"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

        <StackPanel IsEnabled="{Binding CanEdit}">
            <ui:SettingCard Icon="&#xEC4A;" Header="Maximum frame rate"
                            Description="A ceiling, not a boost: Roblox never renders faster than this. Higher caps only help if your PC and screen can keep up.">
                <ComboBox Width="170" ItemsSource="{Binding FramerateChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding FramerateCap}" AutomationProperties.Name="Maximum frame rate" />
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE7F4;" Header="Automatic graphics quality"
                            Description="Lets Roblox pick the quality level from your PC's performance. Turn off to choose a fixed level.">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding QualityAutomatic}" AutomationProperties.Name="Automatic graphics quality" />
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE91B;" Header="Graphics quality"
                            Description="1 is the fastest, 10 the most detailed. Lower levels raise frame rate on slower PCs."
                            Visibility="{Binding QualityAutomatic, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="1" Maximum="10" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding QualityLevel}" AutomationProperties.Name="Graphics quality" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding QualityLabel}" Width="52" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE740;" Header="Fullscreen" Description="Start Roblox in fullscreen instead of a window.">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Fullscreen}" AutomationProperties.Name="Fullscreen" />
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE767;" Header="Volume" Description="Roblox's master volume.">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="100" SmallChange="10" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="10"
                            Value="{Binding VolumePercent}" AutomationProperties.Name="Volume" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VolumePercent, StringFormat='{}{0:0}%'}" Width="52" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE962;" Header="Camera sensitivity" Description="How fast the camera turns with the mouse.">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0.1" Maximum="4" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.1"
                            Value="{Binding MouseSensitivity}" AutomationProperties.Name="Camera sensitivity" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MouseSensitivity, StringFormat='{}{0:0.0}'}" Width="52" TextAlignment="Right" Style="{StaticResource Text.Base}" VerticalAlignment="Center" />
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Icon="&#xE7AD;" Header="Invert camera vertically" Description="Moving the mouse up looks down.">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding InvertCamera}" AutomationProperties.Name="Invert camera" />
            </ui:SettingCard>
        </StackPanel>

        <!-- ===== Launch preferences ===== -->
        <TextBlock Text="Launch preferences" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8BB;" Header="Close Nexstrap after launch"
                        Description="Hide the launcher once Roblox starts. With Discord Rich Presence on it keeps running in the background until Roblox closes.">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseAfterLaunch}" AutomationProperties.Name="Close after launch" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE71B;" Header="Open website Play buttons with Nexstrap" Description="{Binding LinkHandlerText}">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding UseNexstrapForLinks}" AutomationProperties.Name="Use Nexstrap for website links" />
        </ui:SettingCard>

        <!-- ===== Installation ===== -->
        <TextBlock Text="Installation" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE7B8;" Header="Roblox build" Description="{Binding InstallationText}">
            <Button Content="Manage on Home" Padding="10,5" Command="{Binding ManageInstallationsCommand}" />
        </ui:SettingCard>

        <!-- ===== Backups ===== -->
        <DockPanel Margin="2,18,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Back up now" ui:Ui.Icon="&#xE74E;" Padding="10,4"
                    Command="{Binding BackupNowCommand}" />
            <StackPanel>
                <TextBlock Text="Backups of Roblox's settings" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Made automatically before every save or restore. The newest 15 are kept." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="18,10">
            <StackPanel>
                <TextBlock Text="No backups yet." Style="{StaticResource Text.Caption}" Margin="0,4"
                           Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,5">
                                <Button DockPanel.Dock="Right" Content="Restore" Padding="10,4"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding CreatedLocal, StringFormat='{}{0:g}'}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Advanced ===== -->
        <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" />
        <ui:SettingCard Icon="&#xE8B7;" Header="Roblox's settings folder" Description="Where GlobalBasicSettings_13.xml lives.">
            <Button Content="Open" ui:Ui.Icon="&#xE838;" Padding="10,5" Command="{Binding OpenSettingsFolderCommand}" />
        </ui:SettingCard>
        <ui:SettingCard Icon="&#xE9F9;" Header="Roblox's logs" Description="Useful when reporting a problem with Roblox itself.">
            <Button Content="Open" ui:Ui.Icon="&#xE838;" Padding="10,5" Command="{Binding OpenRobloxLogsCommand}" />
        </ui:SettingCard>
    </StackPanel>
</UserControl>
