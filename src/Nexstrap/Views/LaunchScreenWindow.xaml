<Window x:Class="Nexstrap.Views.LaunchScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexstrap" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" FontFamily="{DynamicResource Font.Primary}">
    <Border x:Name="Root" BorderThickness="1" BorderBrush="#30FFFFFF" ClipToBounds="True">
        <Grid>
            <Border x:Name="Picture" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ContentPresenter x:Name="Logo" Width="72" Height="72" RenderTransformOrigin="0.5,0.5"
                                  ContentTemplate="{StaticResource Template.LogoMark}" Content="{Binding}" />
                <Image x:Name="LogoPicture" Width="72" Height="72" Stretch="Uniform" Visibility="Collapsed" />
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" FontSize="13" Margin="0,5,0,0" Opacity="0.8" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Only one of these runs, depending on the chosen animation -->
                <Grid Height="34" Margin="0,18,0,0">
                    <Ellipse x:Name="Spinner" Width="30" Height="30" StrokeThickness="3" StrokeDashArray="14 8" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerTurn" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border x:Name="BarTrack" Width="240" Height="4" CornerRadius="2" Background="#30FFFFFF" ClipToBounds="True"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Border x:Name="BarFill" Width="80" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BarMove" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="DotOne" Width="10" Height="10" Margin="5,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="DotOneMove" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="DotTwo" Width="10" Height="10" Margin="5,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="DotTwoMove" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="DotThree" Width="10" Height="10" Margin="5,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="DotThreeMove" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
