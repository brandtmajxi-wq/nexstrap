<Window x:Class="Nexstrap.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexstrap" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Primary}">
    <Border Margin="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBadge" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" FontSize="15" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Section}" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" FontSize="13.5" LineHeight="20" />

            <Expander x:Name="DetailsExpander" Margin="0,12,0,0" Visibility="Collapsed" Foreground="{DynamicResource Brush.TextSecondary}">
                <Expander.Header>
                    <TextBlock Text="Technical details" Style="{StaticResource Text.Caption}" FontSize="12" />
                </Expander.Header>
                <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" Margin="0,8,0,0"
                         FontFamily="{StaticResource Font.Mono}" FontSize="11" VerticalScrollBarVisibility="Auto" />
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Margin="0,0,8,0" MinWidth="90" IsCancel="True" Click="OnCancel" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" MinWidth="90" IsDefault="True" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
