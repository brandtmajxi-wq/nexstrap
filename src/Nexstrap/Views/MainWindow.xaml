<Window x:Class="Nexstrap.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nexstrap.ViewModels"
        xmlns:ui="clr-namespace:Nexstrap.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="Nexstrap" Icon="/Resources/Branding/Nexstrap.ico"
        Width="1120" Height="720" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{DynamicResource Font.Primary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar entry; RadioButton gives single-selection + keyboard navigation for free -->
        <DataTemplate x:Key="Template.NavItem">
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="{Binding Title}" ui:Ui.Icon="{Binding Glyph}"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Optional custom background image (Appearance → Background) behind everything -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Brush.BackgroundImage}" IsHitTestVisible="False" />

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,14">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,18,0,26">
                    <ContentPresenter Width="34" Height="34" ContentTemplate="{StaticResource Template.LogoMark}" Content="{Binding}" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName}" Style="{StaticResource Text.Base}" FontSize="16.5" FontWeight="Bold" />
                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Divider}" Margin="6,0,6,8" />
                    <ItemsControl ItemsSource="{Binding FooterItems}" ItemTemplate="{StaticResource Template.NavItem}" Focusable="False" />
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Caption}" Margin="8,10,6,0" />
                </StackPanel>

                <!-- Navigation items -->
                <StackPanel>
                    <TextBlock Text="MENU" Style="{StaticResource Text.Overline}" Margin="8,0,0,8" />
                    <ItemsControl ItemsSource="{Binding NavItems}" ItemTemplate="{StaticResource Template.NavItem}" Focusable="False" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Title bar: draggable area + caption buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" ToolTip="Maximize" Click="OnMaximize" />
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" ToolTip="Close" Click="OnClose" />
            </StackPanel>

            <!-- Page host -->
            <Grid x:Name="PageHost" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Margin="36,0,36,18">
                    <!-- Update banner: set by the quick check each launch -->
                    <Border CornerRadius="10" Padding="14,8" Margin="0,0,0,14" Background="{DynamicResource Brush.AccentSoft}"
                            Visibility="{Binding UpdateBanner, Converter={StaticResource NullToVisibility}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Primary}" Content="View update" Padding="10,4" Command="{Binding ViewUpdateCommand}" />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="11"
                                        Width="28" Height="28" Margin="4,0,0,0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss update banner"
                                        Command="{Binding DismissUpdateCommand}" />
                            </StackPanel>
                            <TextBlock Text="&#xE896;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding UpdateBanner}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding Navigation.CurrentPage.Title}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Navigation.CurrentPage.Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentControl Content="{Binding Navigation.CurrentPage}" Margin="36,0,36,32" Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
